# deck-box: Docker's docker-default with mount and pivot_root allowed, so bubblewrap builds deck's boxes inside.
# The abi of AppArmor 3 leaves user namespaces open on AppArmor 4 too. Load it once on the host:
#   sudo install -m644 deck-box.apparmor /etc/apparmor.d/deck-box && sudo apparmor_parser -r /etc/apparmor.d/deck-box
abi <abi/3.0>,
#include <tunables/global>
profile deck-box flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network vsock,
  capability,
  file,
  umount,
  mount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=deck-box,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^ku]** w,
  deny @{PROC}/sys/{u[^s],us[^e],use[^r],user[^/]}** w,
  # bwrap --disable-userns writes the limit of the namespace it made; the kernel lets no other one change.
  deny @{PROC}/sys/user/{[^m],m[^a],ma[^x],max[^_],max_[^u],max_u[^s],max_us[^e],max_use[^r],max_user[^_],max_user_[^n],max_user_n[^a],max_user_na[^m],max_user_nam[^e],max_user_name[^s],max_user_names[^p],max_user_namesp[^a],max_user_namespa[^c],max_user_namespac[^e],max_user_namespace[^s]}** w,
  deny @{PROC}/sys/user/max_user_namespaces?** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer=deck-box,
}
