{
  "version": 5,
  "commands": [
    {
      "name": "run",
      "title": "Run",
      "description": "Works on the cards in Ready in the repo folder, or merges, reverts, pushes or shows a run.",
      "class": "internal",
      "callers": [
        "owner",
        "master"
      ],
      "requires": [
        "sandbox"
      ],
      "provider": "claude-code",
      "timeout_minutes": 240,
      "input": {
        "type": "object",
        "properties": {
          "do": {
            "type": "string",
            "enum": [
              "run",
              "merge",
              "revert",
              "push",
              "diff"
            ],
            "description": "run by default"
          },
          "run": {
            "type": "integer",
            "format": "process",
            "description": "The run to merge, revert or show; the latest one when omitted"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "summary"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "description": "What was done, in plain words"
          },
          "branch": {
            "type": "string"
          }
        }
      },
      "executor": {
        "type": "agent",
        "folder": true,
        "prompt_file": "prompts/run.md"
      }
    }
  ],
  "board": {
    "lanes": [
      {
        "name": "backlog",
        "title": "Backlog",
        "role": "inbox"
      },
      {
        "name": "ready",
        "title": "Ready",
        "role": "ready"
      },
      {
        "name": "running",
        "title": "Running",
        "role": "running"
      },
      {
        "name": "review",
        "title": "Review",
        "role": "review"
      },
      {
        "name": "done",
        "title": "Done",
        "role": "done"
      }
    ]
  },
  "screens": [
    {
      "name": "board",
      "title": "Board",
      "blocks": [
        {
          "type": "actions",
          "title": "Runs",
          "actions": [
            {
              "label": "Run",
              "command": "run",
              "params": {
                "do": "run"
              }
            },
            {
              "label": "Show the diff",
              "command": "run",
              "params": {
                "do": "diff"
              }
            },
            {
              "label": "Merge",
              "command": "run",
              "params": {
                "do": "merge"
              }
            },
            {
              "label": "Revert the merge",
              "command": "run",
              "params": {
                "do": "revert"
              }
            },
            {
              "label": "Push",
              "command": "run",
              "params": {
                "do": "push"
              }
            }
          ]
        },
        {
          "type": "board",
          "title": "Board"
        },
        {
          "type": "list",
          "title": "Runs",
          "source": {
            "from": "processes",
            "where": "command == 'run'",
            "limit": 10
          },
          "item": {
            "title": "'#' + string(id) + ' · ' + state",
            "text": "error",
            "meta": "started_at"
          }
        }
      ]
    }
  ],
  "menu": [
    "board"
  ]
}
