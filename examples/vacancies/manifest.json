{
  "version": 4,
  "autonomy": "suggest",
  "collections": [
    {
      "name": "sources",
      "description": "A place job postings come from: a link, how it is parsed, and how its last read went.",
      "key": "url",
      "display": "name != '' ? name : url",
      "schema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {"type": "string", "description": "Link that is read"},
          "name": {"type": "string"},
          "parser": {"type": "string", "description": "Parser of the collect script: hn_whoishiring or remoteok; empty picks by host"},
          "enabled": {"type": "boolean", "default": true},
          "status": {"enum": ["new", "ok", "error"]},
          "last_error": {"type": "string"},
          "last_read": {"type": "string", "format": "date-time"},
          "last_new": {"type": "integer"},
          "cursor": {"type": "object", "description": "Where the last read stopped; kept by the script"}
        }
      }
    },
    {
      "name": "postings",
      "description": "One job posting found in a source, with its rating against criteria.md.",
      "key": "url",
      "display": "company + ' — ' + role",
      "immutable": ["url", "source", "found"],
      "retention_days": 120,
      "schema": {
        "type": "object",
        "required": ["url", "source", "found"],
        "properties": {
          "url": {"type": "string"},
          "company": {"type": "string"},
          "role": {"type": "string"},
          "location": {"type": "string"},
          "remote": {"type": "boolean"},
          "salary": {"type": "string"},
          "text": {"type": "string"},
          "source": {"type": "string", "description": "URL of the source record"},
          "source_name": {"type": "string"},
          "posted": {"type": "string"},
          "found": {"type": "string", "format": "date"},
          "card": {"type": "integer", "description": "Board card, when the posting fits or may fit"},
          "rating": {
            "type": "object",
            "required": ["choice", "probabilities", "confidence", "reason"],
            "properties": {
              "choice": {"enum": ["fits", "maybe", "no"]},
              "probabilities": {
                "type": "object",
                "required": ["fits", "maybe", "no"],
                "properties": {
                  "fits": {"type": "number", "minimum": 0, "maximum": 1},
                  "maybe": {"type": "number", "minimum": 0, "maximum": 1},
                  "no": {"type": "number", "minimum": 0, "maximum": 1}
                }
              },
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "reason": {"type": "string"},
              "rated": {"type": "string", "format": "date"}
            }
          }
        }
      }
    }
  ],
  "scripts": [
    {"name": "collect", "file": "scripts/collect.py", "runtime": "python", "timeout_minutes": 10},
    {"name": "prepare", "file": "scripts/prepare.py", "runtime": "python", "timeout_minutes": 5},
    {"name": "apply", "file": "scripts/apply.py", "runtime": "python", "timeout_minutes": 5}
  ],
  "commands": [
    {
      "name": "collect",
      "title": "Collect postings",
      "description": "Reads every source from its cursor and writes only new postings; a source that fails gets status error.",
      "class": "internal",
      "callers": ["owner", "trigger", "agent"],
      "input": {
        "type": "object",
        "properties": {
          "source": {"type": "string", "description": "Only this source URL"}
        }
      },
      "result": {
        "type": ["object", "null"],
        "properties": {
          "new": {"type": "integer"},
          "waiting": {"type": "integer", "description": "Postings without a rating, new or left over"},
          "ids": {"type": "array", "items": {"type": "integer"}},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "url": {"type": "string"},
                "status": {"enum": ["ok", "error"]},
                "new": {"type": "integer"},
                "error": {"type": "string"}
              }
            }
          }
        }
      },
      "executor": {"type": "script", "script": "collect"}
    },
    {
      "name": "prepare",
      "title": "Rate waiting postings",
      "description": "Takes the oldest postings without a rating as short excerpts for the rating agent; starts the rating chain.",
      "class": "internal",
      "callers": ["owner", "trigger", "master"],
      "input": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "description": "At most this many postings in one batch", "default": 150},
          "process": {"type": "integer", "description": "The collect process that ran before"}
        }
      },
      "result": {
        "type": ["object", "null"],
        "properties": {
          "items": {"type": "array", "items": {"type": "object"}},
          "left": {"type": "integer"},
          "source_errors": {"type": "array", "items": {"type": "string"}}
        }
      },
      "executor": {"type": "script", "script": "prepare"}
    },
    {
      "name": "rate",
      "title": "Rate postings",
      "description": "Rates a batch of postings against criteria.md; its result is the daily summary with one line per rejected posting.",
      "class": "internal",
      "callers": ["owner", "trigger", "master"],
      "requires": ["tools", "structured_output"],
      "timeout_minutes": 60,
      "input": {
        "type": "object",
        "required": ["process"],
        "properties": {
          "process": {"type": "integer", "description": "The prepare process whose batch is rated"}
        }
      },
      "result": {
        "type": ["object", "null"],
        "required": ["ratings", "rated", "fits", "maybe", "no", "rejected", "summary"],
        "properties": {
          "ratings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "choice", "probabilities", "confidence", "reason"],
              "properties": {
                "id": {"type": "integer"},
                "choice": {"enum": ["fits", "maybe", "no"]},
                "probabilities": {
                  "type": "object",
                  "required": ["fits", "maybe", "no"],
                  "properties": {
                    "fits": {"type": "number", "minimum": 0, "maximum": 1},
                    "maybe": {"type": "number", "minimum": 0, "maximum": 1},
                    "no": {"type": "number", "minimum": 0, "maximum": 1}
                  }
                },
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "reason": {"type": "string"},
                "fixes": {
                  "type": "object",
                  "properties": {
                    "company": {"type": "string"},
                    "role": {"type": "string"},
                    "location": {"type": "string"},
                    "remote": {"type": "boolean"},
                    "salary": {"type": "string"}
                  }
                }
              }
            }
          },
          "rated": {"type": "integer"},
          "fits": {"type": "integer"},
          "maybe": {"type": "integer"},
          "no": {"type": "integer"},
          "left": {"type": "integer", "description": "Postings still without a rating"},
          "rejected": {"type": "array", "items": {"type": "string"}, "description": "One line per rejected posting"},
          "source_errors": {"type": "array", "items": {"type": "string"}},
          "summary": {"type": "string"}
        }
      },
      "executor": {"type": "agent", "prompt_file": "prompts/rate.md"}
    },
    {
      "name": "apply",
      "title": "Apply ratings",
      "description": "Writes the ratings of a rate run into the postings and creates cards in Found for those that fit or may fit.",
      "class": "internal",
      "callers": ["owner", "trigger"],
      "input": {
        "type": "object",
        "required": ["process"],
        "properties": {
          "process": {"type": "integer", "description": "The rate process"}
        }
      },
      "result": {
        "type": ["object", "null"],
        "properties": {
          "updated": {"type": "integer"},
          "cards": {"type": "array", "items": {"type": "integer"}},
          "unknown_ids": {"type": "array", "items": {"type": "integer"}}
        }
      },
      "executor": {"type": "script", "script": "apply"}
    },
    {
      "name": "package",
      "title": "Prepare application package",
      "description": "Writes a CV tailored to the posting and a short cover letter from facts.md, binds them to the card and moves it to Package ready.",
      "class": "internal",
      "callers": ["owner", "trigger"],
      "requires": ["tools", "structured_output"],
      "timeout_minutes": 30,
      "input": {
        "type": "object",
        "required": ["card"],
        "properties": {
          "card": {"type": "integer", "description": "Card of the posting"}
        }
      },
      "result": {
        "type": ["object", "null"],
        "required": ["cv", "cover_letter", "missing_facts", "moved"],
        "properties": {
          "cv": {"type": "string", "description": "Document name of the CV"},
          "cover_letter": {"type": "string", "description": "Document name of the cover letter"},
          "missing_facts": {"type": "array", "items": {"type": "string"}},
          "moved": {"type": "boolean"}
        }
      },
      "executor": {"type": "agent", "prompt_file": "prompts/package.md", "skills": ["job-package"]}
    }
  ],
  "triggers": [
    {"command": "collect", "cron": "0 7 * * *"},
    {"command": "prepare", "after": "collect"},
    {"command": "rate", "after": "prepare"},
    {"command": "apply", "after": "rate"},
    {"command": "package", "lane": "interesting"}
  ],
  "domains": {
    "read": ["hn.algolia.com", "remoteok.com"]
  },
  "board": {
    "lanes": [
      {"name": "found", "title": "Found", "role": "inbox"},
      {"name": "interesting", "title": "Interesting"},
      {"name": "package_ready", "title": "Package ready"},
      {"name": "sent", "title": "Sent"},
      {"name": "reply", "title": "Reply"},
      {"name": "archive", "title": "Archive", "role": "done"}
    ]
  }
}