{
  "name": "cockpit",
  "icon": "sun",
  "title": "Today",
  "blocks": [
    {"type": "list", "title": "Decisions", "span": "full", "focus": true, "source": {"from": "deck.asks_list"},
      "empty": "All decided",
      "item": {"title": "what", "text": "(why ?? '') != '' ? why : where",
        "kind": "kind == 'question' ? 'Question' : kind == 'grant' ? 'New right' : kind in ['sign_in', 'login'] ? 'Sign-in' : kind == 'unknown' ? 'Unknown outcome' : 'Action'",
        "icon": "kind == 'question' ? 'message-question' : kind in ['sign_in', 'login'] ? 'key' : kind == 'unknown' ? 'help-triangle' : kind == 'grant' ? 'shield-check' : 'send'",
        "meta": "join(filter([(why ?? '') != '' ? where : '', project, who], # != ''), ' · ')", "since": "created_at", "tone": "expired ? 'muted' : 'warn'",
        "details": "join(filter([by ?? '', command ?? '', kind in ['call', 'unknown', 'confirm', 'grant'] ? toJSON(payload) : ''], # != ''), '\\n')",
        "questions": "kind == 'question' && len(payload?.questions ?? []) > 0 ? payload.questions : nil"},
      "actions": [
        {"verb": "answer", "primary": true, "hold": true, "command": "deck.ask_answer", "params": {"ask": "=id"}, "input": "answer", "when": "kind == 'question' && !expired"},
        {"verb": "retry", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "retry"}, "when": "kind == 'unknown' && !expired"},
        {"verb": "mark_done", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "done"}, "when": "kind == 'unknown' && !expired"},
        {"label": "=(allow ?? '') != '' ? allow : 'Allow'", "icon": "check", "primary": true, "hold": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "allow"}, "until": "=expires_at", "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
        {"verb": "deny", "hold": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
        {"label": "=always", "hold": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "allow_always"}, "until": "=expires_at", "when": "kind == 'call' && (always ?? '') != '' && !expired"},
        {"verb": "deny_because", "hold": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "input": "reason", "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
        {"verb": "retry", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "retry"}, "when": "kind == 'login' && !expired"},
        {"verb": "new_session", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "new_session"}, "when": "kind == 'login' && !expired"},
        {"verb": "sign_in", "primary": true, "command": "deck.browser_login", "params": {"url": "='https://' + payload.site"}, "when": "kind == 'sign_in' && (payload?.site ?? '') != '' && !expired"},
        {"verb": "signed_in", "command": "deck.browser_login_done", "params": {"url": "='https://' + payload.site"}, "when": "kind == 'sign_in' && (payload?.site ?? '') != '' && !expired"},
        {"verb": "sign_in", "primary": true, "command": "deck.oauth_start", "params": {"tool": "=payload?.tool ?? ''"}, "when": "kind == 'sign_in' && (payload?.site ?? '') == '' && !expired"},
        {"verb": "deny", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "when": "expired"}
      ]},
    {"type": "list", "title": "Running", "span": "full", "icon": "activity", "source": {"from": "deck.processes_list", "input": {"open": true}},
      "empty": "nothing, all waits for the schedule",
      "item": {"title": "((topic ?? '') != '' ? topic : (title ?? '') != '' ? title : command) + ((record_title ?? '') != '' ? ' · ' + record_title : '')",
        "tone": "tone ?? ''", "text": "state == 'running' && (ask ?? 0) == 0 ? '' : word", "since": "since ?? ''", "icon": "'activity'",
        "details": "'#' + string(id) + ((parent ?? 0) != 0 ? ' of #' + string(parent) : '') + ' · ' + project + '.' + command + ' · ' + word"},
      "actions": [
        {"verb": "open", "screen": "process", "record": "=id"},
        {"verb": "stop", "command": "deck.process_stop", "params": {"process": "=id"}, "when": "(finished_at ?? '') == ''"}
      ]},
    {"type": "list", "title": "What was", "span": "full", "source": {"from": "deck.feed_list", "input": {"failures": true}, "limit": 20},
      "empty": "Nothing happened yet today",
      "head": [
        {"verb": "read_all", "command": "deck.feed_read", "params": {"all": "true"}, "confirm": true, "when": "len(filter(rows, #.can_read)) > 0"}
      ],
      "item": {"title": "text", "since": "created_at",
        "icon": "kind == 'failure' ? 'alert-circle' : kind == 'change' ? 'checks' : 'news'",
        "tone": "kind == 'failure' ? 'error' : ''",
        "meta": "kind == 'failure' ? join(filter([error, project, (repeats ?? 0) > 1 ? '×' + string(repeats) : ''], # != ''), ' · ') : kind == 'change' ? join(filter([project, author, 'done without you'], # != ''), ' · ') : (len(projects ?? []) > 1 ? join(projects, ', ') : project + ' · ' + author) + ((repeats ?? 1) > 1 && len(parts ?? []) == 0 ? ' · ×' + string(repeats) : '')",
        "details": "kind == 'failure' && (process ?? 0) != 0 ? '#' + string(process) + ((error_type ?? '') != '' ? ' · ' + error_type : '') : len(parts ?? []) > 1 ? join(map(parts, #.project + ': ' + #.text), '\\n') : ''"},
      "actions": [
        {"verb": "undo", "command": "deck.feed_undo", "params": {"entry": "=id"}, "when": "can_undo"},
        {"verb": "retry", "command": "deck.process_retry", "params": {"process": "=process"}, "when": "kind == 'failure' && (retry ?? false)"},
        {"verb": "open", "screen": "=screen", "project": "=deck_screen ? '' : project", "record": "=record", "when": "kind != 'failure' && screen != ''"},
        {"verb": "open", "screen": "process", "record": "=process", "when": "kind == 'failure' && (process ?? 0) != 0"},
        {"verb": "open", "screen": "deck/settings", "params": {"tab": "Health"}, "when": "kind == 'failure' && (check ?? '') != ''"},
        {"verb": "close", "command": "deck.process_dismiss", "params": {"process": "=process"}, "when": "kind == 'failure' && (process ?? 0) != 0"},
        {"verb": "mark_read", "command": "deck.health_seen", "params": {"subject": "=check", "project": "=project"}, "when": "kind == 'failure' && (check ?? '') != ''"},
        {"verb": "mark_read", "command": "deck.feed_read", "params": {"entry": "=id"}, "when": "can_read"}
      ]},
    {"type": "dialog", "name": "changes", "title": "History", "icon": "history", "blocks": [
      {"type": "table", "title": "Done without you", "empty": "Nothing was done without you yet", "source": {"from": "deck.feed_list", "input": {"kind": "change", "limit": 500}, "limit": 50},
        "columns": [
          {"label": "What", "bind": "text"},
          {"label": "Module", "bind": "project", "format": "tag"},
          {"label": "Who", "bind": "author", "format": "tag"},
          {"label": "When", "bind": "created_at", "format": "relative"}
        ],
        "actions": [
          {"verb": "undo", "command": "deck.feed_undo", "params": {"entry": "=id"}, "when": "can_undo"}
        ]},
      {"type": "table", "title": "Notes", "empty": "No notes yet", "source": {"from": "deck.feed_list", "input": {"kind": "note", "limit": 500}, "limit": 50},
        "description": "Every note, those read or read all at once too.",
        "columns": [
          {"label": "Note", "bind": "text"},
          {"label": "Module", "bind": "project", "format": "tag"},
          {"label": "Read", "bind": "read ? 'read' : 'unread'", "format": "tag", "tone": "read ? 'muted' : 'warn'"},
          {"label": "When", "bind": "created_at", "format": "relative"}
        ],
        "actions": [
          {"verb": "open", "screen": "=screen", "project": "=deck_screen ? '' : project", "record": "=record", "when": "screen != ''"}
        ]}]},
    {"type": "list", "title": "Start with a module", "icon": "rocket", "span": 2, "cards": true, "when": "len(rows) > 0", "source": {"from": "deck.starters_list"},
      "description": "A module comes as a draft: see what it can do, then enable it.",
      "item": {"title": "title", "text": "description", "icon": "icon != '' ? icon : 'box'",
        "meta": "status == 'draft' ? 'A draft: not enabled yet' : ''", "tone": "status == 'draft' ? 'warn' : ''"},
      "actions": [
        {"label": "Add as a draft", "icon": "download", "primary": true, "command": "deck.project_import", "params": {"starter": "=name"}, "when": "status == ''"},
        {"label": "What it can do", "icon": "shield-check", "primary": true, "screen": "draft", "params": {"project": "=name", "revision": "=revision"}, "when": "status == 'draft'"}
      ]}
  ]
}
