{
  "name": "cockpit",
  "icon": "layout-dashboard",
  "title": "Cockpit",
  "blocks": [
    {"type": "list", "title": "Needs your decision", "icon": "hand-finger", "span": 2, "when": "len(rows) > 0", "source": {"from": "deck.asks_list"},
        "description": "Nothing moves on without your answer.",
      "item": {"title": "what", "text": "(why ?? '') != '' && (where ?? '') != '' ? why + ' — ' + where : (why ?? '') != '' ? why : where",
        "icon": "kind == 'question' ? 'message-question' : kind in ['sign_in', 'login'] ? 'key' : kind == 'unknown' ? 'help-triangle' : kind == 'grant' ? 'shield-check' : 'send'", "meta": "join(filter([who, project], # != ''), ' · ')", "since": "created_at", "tone": "expired ? 'muted' : 'warn'",
        "details": "join(filter([by ?? '', command ?? '', kind in ['call', 'unknown', 'confirm', 'grant'] ? toJSON(payload) : ''], # != ''), '\\n')",
        "questions": "kind == 'question' && len(payload?.questions ?? []) > 0 ? payload.questions : nil"},
      "actions": [
        {"verb": "answer", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id"}, "input": "answer", "when": "kind == 'question' && !expired"},
        {"verb": "retry", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "retry"}, "when": "kind == 'unknown' && !expired"},
        {"verb": "mark_done", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "done"}, "when": "kind == 'unknown' && !expired"},
        {"verb": "allow", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "allow"}, "until": "=expires_at", "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
        {"label": "=always", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "allow_always"}, "until": "=expires_at", "when": "kind == 'call' && (always ?? '') != '' && !expired"},
        {"verb": "deny", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
        {"verb": "deny_because", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "input": "reason", "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
        {"verb": "retry", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "retry"}, "when": "kind == 'login' && !expired"},
        {"verb": "new_session", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "new_session"}, "when": "kind == 'login' && !expired"},
        {"verb": "sign_in", "primary": true, "command": "deck.browser_login", "params": {"url": "='https://' + payload.site"}, "when": "kind == 'sign_in' && (payload?.site ?? '') != '' && !expired"},
        {"verb": "signed_in", "command": "deck.browser_login_done", "params": {"url": "='https://' + payload.site"}, "when": "kind == 'sign_in' && (payload?.site ?? '') != '' && !expired"},
        {"verb": "sign_in", "primary": true, "command": "deck.oauth_start", "params": {"tool": "=payload?.tool ?? ''"}, "when": "kind == 'sign_in' && (payload?.site ?? '') == '' && !expired"},
        {"verb": "deny", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "when": "expired"}
      ]},
    {"type": "list", "title": "Did not work", "span": 1, "icon": "alert-circle", "when": "len(rows) > 0",
      "source": {"from": "deck.processes_list", "input": {"failed": true, "brief": true}, "limit": 20},
      "description": "Close one you will not repeat.",
      "item": {"title": "((title ?? '') != '' ? title : command) + ((record_title ?? '') != '' ? ' · ' + record_title : '')", "tone": "'error'", "icon": "'alert-circle'",
        "text": "(error ?? '') != '' ? error : word", "since": "finished_at ?? ''",
        "meta": "project + ((repeats ?? 0) > 1 ? ' · ×' + string(repeats) : '')",
        "details": "'#' + string(id) + ' · ' + project + '.' + command + ((error_type ?? '') != '' ? ' · ' + error_type : '') + ((provider ?? '') != '' ? ' · ' + provider : '')"},
      "actions": [
        {"verb": "retry", "primary": true, "command": "deck.process_retry", "params": {"process": "=id"}, "when": "retry ?? false"},
        {"verb": "open", "screen": "process", "record": "=id"},
        {"verb": "close", "command": "deck.process_dismiss", "params": {"process": "=id"}}
      ]},
    {"type": "list", "title": "Running now", "span": 1, "icon": "activity", "when": "len(rows) > 0",
      "source": {"from": "deck.processes_list", "input": {"open": true}},
      "item": {"title": "((topic ?? '') != '' ? topic : (title ?? '') != '' ? title : command) + ((record_title ?? '') != '' ? ' · ' + record_title : '')",
        "tone": "tone ?? ''", "text": "state == 'running' && (ask ?? 0) == 0 ? '' : word", "since": "since ?? ''",
        "icon": "kind == 'script' ? 'code' : kind == 'tool' ? 'tool' : kind == 'model' ? 'sparkles' : 'robot'",
        "meta": "project + ((trigger ?? 0) != 0 ? ' · by schedule' : '')",
        "details": "'#' + string(id) + ((parent ?? 0) != 0 ? ' of #' + string(parent) : '') + ' · ' + project + '.' + command + ' · ' + word"},
      "actions": [
        {"verb": "open", "screen": "process", "record": "=id"},
        {"verb": "stop", "command": "deck.process_stop", "params": {"process": "=id"}, "when": "(finished_at ?? '') == ''"}
      ]},
    {"type": "list", "title": "Notes", "span": 1, "icon": "bell", "when": "len(rows) > 0",
      "source": {"from": "deck.feed_list", "input": {"kind": "note", "unread": true}, "limit": 10},
      "item": {"title": "text", "icon": "'news'", "since": "created_at",
        "meta": "(len(projects ?? []) > 1 ? join(projects, ', ') : project + ' · ' + author) + ((repeats ?? 1) > 1 && len(parts ?? []) == 0 ? ' · ×' + string(repeats) : '')",
        "details": "len(parts ?? []) > 1 ? join(map(parts, #.project + ': ' + #.text), '\\n') : ''"},
      "actions": [
        {"verb": "open", "screen": "=screen", "project": "=deck_screen ? '' : project", "record": "=record", "when": "screen != ''"},
        {"verb": "mark_read", "primary": true, "command": "deck.feed_read", "params": {"entry": "=id"}}
      ]},
    {"type": "list", "title": "Done without you", "span": 1, "icon": "checks", "when": "len(rows) > 0", "source": {"from": "deck.feed_list", "input": {"kind": "change"}, "limit": 3},
      "item": {"title": "text", "since": "created_at", "meta": "project + ' · ' + author"},
      "actions": [
        {"verb": "undo", "command": "deck.feed_undo", "params": {"entry": "=id"}, "when": "can_undo"}
      ]},
    {"type": "dialog", "name": "changes", "title": "History", "icon": "history", "blocks": [
      {"type": "table", "title": "Done without you", "source": {"from": "deck.feed_list", "input": {"kind": "change", "limit": 500}, "limit": 50},
        "columns": [
          {"label": "What", "bind": "text"},
          {"label": "Module", "bind": "project", "format": "tag"},
          {"label": "Who", "bind": "author", "format": "tag"},
          {"label": "When", "bind": "created_at", "format": "relative"}
        ],
        "actions": [
          {"verb": "undo", "command": "deck.feed_undo", "params": {"entry": "=id"}, "when": "can_undo"}
        ]},
      {"type": "table", "title": "Notes", "source": {"from": "deck.feed_list", "input": {"kind": "note", "limit": 500}, "limit": 50},
        "description": "Every note, those read or read all at once too.",
        "columns": [
          {"label": "Note", "bind": "text"},
          {"label": "Module", "bind": "project", "format": "tag"},
          {"label": "Read", "bind": "read ? 'read' : 'unread'", "format": "tag", "tone": "read ? 'muted' : 'warn'"},
          {"label": "When", "bind": "created_at", "format": "relative"}
        ],
        "actions": [
          {"verb": "open", "screen": "=screen", "project": "=deck_screen ? '' : project", "record": "=record", "when": "screen != ''"}
        ]}]}
  ]
}
