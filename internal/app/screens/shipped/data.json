{
  "name": "data",
  "icon": "folder",
  "title": "Data folder",
  "params": {"project": "string", "path": "string"},
  "blocks": [
    {"type": "media", "title": "Folder", "span": "full", "source": {"from": "deck.data_read", "input": {"project": "=param.project", "path": "=param.path ?? ''"}, "rows": "entries", "sort": "-dir"},
      "description": "The data folder of the module as it is on disk: what its scripts and agents keep, caches too.",
