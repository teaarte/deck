{
  "name": "draft",
  "icon": "shield-check",
  "title": "Review a draft",
  "params": {"project": "string", "revision": "number"},
  "blocks": [
    {"type": "table", "title": "What it needs to work", "span": "full", "source": {"from": "deck.project_needs_get", "input": {"project": "=param.project"}, "where": "kind != 'right'"},
      "description": "Secrets, programs and models it needs besides what enabling grants; give them before or after enabling it.",
      "empty": "Nothing more: it works once enabled",
      "columns": [
        {"label": "What", "bind": "kind == 'secret' ? 'Secret ' + what : kind == 'program' ? 'Script ' + what : what"},
        {"label": "How", "bind": "detail"},
        {"label": "State", "bind": "done ? 'ready' : (optional ?? false) ? 'optional' : 'needed'", "format": "tag", "tone": "done ? 'ok' : (optional ?? false) ? 'muted' : 'warn'"}
      ],
      "actions": [
        {"label": "Set a secret", "icon": "key", "screen": "settings", "params": {"tab": "Advanced", "dialog": "secret", "name": "=what"}, "when": "kind == 'secret' && !done"},
        {"label": "Models", "icon": "cpu", "screen": "settings", "params": {"tab": "Models"}, "when": "kind == 'model'"}
      ]},
    {"type": "table", "title": "What it may do once enabled", "span": "full", "source": {"from": "deck.project_rights_list", "input": {"project": "=param.project"}},
      "description": "Install modules only from authors you know. Once enabled, a module does what is listed here without asking you again.",
      "empty": "Nothing beyond its own records: it reaches no site, reads no secret and calls no model",
      "columns": [
        {"label": "What", "bind": "what"},
        {"label": "Which", "bind": "detail"}
      ]},
    {"type": "actions", "title": "Enable", "icon": "power",
      "description": "Until then it is a draft: nothing runs by itself, and only its trials run.",
      "actions": [{"verb": "enable", "primary": true, "command": "deck.project_enable", "params": {"project": "=param.project", "revision": "=param.revision"}}]}
  ]
}
