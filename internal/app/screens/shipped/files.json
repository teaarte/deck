{
  "name": "files",
  "icon": "files",
  "title": "Files",
  "blocks": [
    {"type": "tabs", "tabs": [
      {"title": "Files", "icon": "files", "blocks": [
        {"type": "media", "title": "By module", "empty": "No modules yet: tell Deki what to do, or import a module", "span": "full", "source": {"from": "deck.projects_list", "sort": "name"},
          "description": "The files each module made or took, such as the pictures of a video, on the page of the module.",
          "item": {"title": "title", "icon": "(icon ?? '') != '' ? icon : 'box'"},
          "actions": [{"verb": "open", "primary": true, "screen": "settings", "project": "=name", "params": {"tab": "Files"}}]},
        {"type": "media", "title": "All files", "empty": "No files yet: modules keep here what they make", "span": "full", "source": {"from": "deck.files_list", "sort": "-created_at"}, "filter": ["project"],
          "item": {"file": "id", "title": "name"},
          "actions": [
            {"verb": "delete", "command": "deck.file_delete", "params": {"file": "=id"},
             "undo": {"command": "deck.file_restore", "params": {"file": "=id", "owner_kind": "=owner_kind", "owner_id": "=owner_id"}}}
          ]}
      ]},
      {"title": "Data folders", "icon": "folders", "blocks": [
        {"type": "media", "title": "Data folders", "span": "full", "source": {"from": "deck.projects_list", "sort": "name"},
          "description": "The data folder of each module, by its real folders.",
          "item": {"title": "title", "icon": "'folder'"},
          "actions": [{"verb": "open", "primary": true, "screen": "data", "params": {"project": "=name"}}]}
      ]},
      {"title": "Documents", "icon": "file-text", "blocks": [
        {"type": "media", "title": "Documents of the master", "span": "full", "source": {"from": "deck.documents_list", "input": {"project": "master", "with_deleted": true}, "sort": "name"}, "filter": ["kind"],
          "description": "The memory, prompts and skills of the master.",
          "item": {"title": "name",
            "icon": "deleted ? 'trash' : kind == 'skill' ? 'sparkles' : kind == 'script' ? 'code' : kind == 'manifest' ? 'settings' : kind == 'prompt' ? 'message' : 'file-text'"},
          "actions": [
            {"verb": "open", "primary": true, "screen": "document", "project": "master", "record": "=id", "when": "!deleted"},
            {"verb": "restore", "command": "deck.document_restore", "params": {"document": "=id"}, "when": "deleted"},
            {"verb": "delete", "confirm": true, "command": "deck.document_delete", "params": {"document": "=id"}, "when": "!deleted && kind != 'manifest' && !(kind == 'prompt' && owner_kind == '')"}
          ]}
      ]},
      {"title": "Snapshots", "icon": "camera", "blocks": [
        {"type": "table", "title": "Snapshots", "source": {"from": "deck.snapshots_list"},
          "description": "Copies of deck's base, files and the data folders of modules, without secrets: deck takes one a day and before a module is deleted, and keeps the newest. They lie in backups of deck's state folder.",
          "empty": "No snapshot yet: deck takes the first one today, or take one now below",
          "columns": [
            {"label": "Snapshot", "bind": "name"},
            {"label": "Taken", "bind": "taken_at", "format": "relative"},
            {"label": "Size", "bind": "size", "format": "bytes"}
          ]},
        {"type": "form", "title": "Take a snapshot now", "command": "deck.snapshot_create"}
      ]}
    ]}
  ]
}
