{
  "name": "process",
  "icon": "activity",
  "title": "Process",
  "record": "process",
  "blocks": [
    {"type": "card", "fields": [
      {"label": "State", "bind": "word", "format": "tag", "tone": "tone ?? ''"},
      {"label": "Module", "bind": "project", "format": "tag"},
      {"label": "Model", "bind": "provider", "format": "logo"},
      {"label": "Started", "bind": "started_at", "format": "relative"},
      {"label": "Waits until", "bind": "wait?.until ?? nil", "format": "relative"},
      {"label": "Folder held until", "bind": "held_until ?? nil", "format": "relative"},
      {"label": "Speed, tokens a second", "bind": "(speed ?? 0) == 0 ? nil : speed", "format": "number"},
      {"label": "Read from outside", "bind": "(read ?? '') == '' ? nil : read", "format": "tag", "tone": "valued ?? false ? 'warn' : 'muted'"},
      {"label": "Error", "bind": "error"},
      {"label": "Failure type", "bind": "(error_type ?? '') == '' ? nil : error_type + ' · ' + whose", "format": "tag", "tone": "'error'"},
      {"label": "Continues", "bind": "(follows ?? 0) == 0 ? nil : '#' + string(follows)"},
      {"label": "Continued by", "bind": "len(followed_by ?? []) == 0 ? nil : join(map(followed_by, '#' + string(#)), ', ')"}
    ],
    "actions": [
      {"verb": "model", "primary": true, "command": "deck.assignment_set", "params": {"role": "=work.role", "project": "=project", "command": "=command"},
        "input": "model", "options": "=work.choices", "groups": "=work.choice_groups", "notes": "=work.choice_notes ?? nil", "logos": "=work.choice_logos ?? nil", "when": "work != nil"},
      {"verb": "answer", "screen": "cockpit", "params": {"focus": "=string((held_ask ?? 0) != 0 ? held_ask : ask)"},
        "when": "(held_ask ?? 0) != 0 || (wait?.reason ?? '') == 'answer' && (ask ?? 0) != 0"},
      {"verb": "open", "screen": "process", "record": "=held_by", "when": "(held_by ?? 0) != 0"},
      {"verb": "retry", "command": "deck.process_retry", "params": {"process": "=id"}, "when": "retry ?? false"},
      {"verb": "stop", "command": "deck.process_stop", "params": {"process": "=id"}, "when": "(finished_at ?? '') == ''"}
    ]},
    {"type": "card", "title": "Input and result", "icon": "braces", "collapsed": true, "fields": [
      {"label": "Input", "bind": "input == nil ? nil : toJSON(input)"},
      {"label": "Result", "bind": "result == nil ? nil : toJSON(result)"},
      {"label": "Details", "bind": "(error_details ?? '') == '' ? nil : error_details"}
    ]},
    {"type": "log", "title": "Log", "icon": "list-details", "source": {"from": "deck.process_chat_get", "input": {"process": "=id"}},
      "empty": "Nothing in the log: a script logs only what it writes to stderr, a tool or a model call nothing; its input and result are above"},
    {"type": "table", "title": "What it left", "icon": "package", "collapsed": true, "source": {"from": "deck.process_left_list", "input": {"process": "=id"}},
      "when": "(trial ?? false) && len(rows) > 0",
      "description": "The records, files of deck and changes of documents the trial and the processes it started made; what a script or an agent wrote into the data folder of the project is not listed and is not undone.",
      "columns": [
        {"label": "Kind", "bind": "kind", "format": "tag"},
        {"label": "What", "bind": "text"}
      ],
      "actions": [
        {"verb": "undo", "command": "deck.feed_undo", "params": {"entry": "=id"}, "when": "kind == 'change' && (undo ?? false)"},
        {"verb": "delete", "command": "deck.record_delete", "params": {"record": "=id"}, "when": "kind == 'record'"},
        {"verb": "delete", "confirm": true, "command": "deck.file_delete", "params": {"file": "=id"}, "when": "kind == 'file'"}
      ]},
    {"type": "table", "title": "Calls of the gateway", "icon": "arrows-exchange", "collapsed": true, "source": {"from": "deck.calls_list", "input": {"process": "=id"}},
      "description": "The tools and commands this run called through deck, and how each ended.",
      "empty": "It called nothing through deck",
      "columns": [
        {"label": "When", "bind": "created_at", "format": "relative"},
        {"label": "Tool", "bind": "tool"},
        {"label": "Outcome", "bind": "outcome", "format": "tag", "details": "error", "tone": "outcome == 'done' ? 'ok' : outcome == 'rejected' || outcome == 'expired' ? 'error' : ''"},
        {"label": "Right", "bind": "need", "format": "tag"}
      ]}
  ]
}
