{
  "name": "settings",
  "icon": "adjustments",
  "title": "Settings",
  "params": {"name": "string", "command": "string"},
  "blocks": [
    {"type": "tabs", "tabs": [
      {"title": "Module", "icon": "box", "blocks": [
          {"type": "dialog", "name": "try-command", "title": "Try a command", "icon": "flask", "blocks": [
            {"type": "form", "command": "deck.command_try", "keep_open": true, "values": {"command": "=param.command"},
              "description": "Runs a command once to see what it does: its calls outside deck are declined, and a paid model waits for your yes.",
              "choices": {"command": {"source": {"from": "deck.commands_list", "where": "executor != 'tool' && executor != ''", "sort": "name"}, "value": "name", "label": "title + ' (' + name + ')'"}}}]},
          {"type": "list", "title": "Module", "source": {"from": "deck.projects_list"},
            "item": {"title": "title", "icon": "icon != '' ? icon : 'box'", "text": "manifest_error != '' ? 'manifest: ' + manifest_error : description",
              "meta": "(title != name ? name + ' · ' : '') + meta",
              "tone": "manifest_error != '' ? 'error' : paused ? 'muted' : status == 'draft' ? 'warn' : ''"},
            "actions": [
              {"verb": "enable", "primary": true, "command": "deck.project_enable", "params": {"project": "=name", "revision": "=revision"}, "when": "manifest_error == '' && status == 'draft'"},
              {"verb": "pause", "command": "deck.project_pause", "params": {"project": "=name", "paused": "true"}, "when": "!paused"},
              {"verb": "resume", "command": "deck.project_pause", "params": {"project": "=name", "paused": "false"}, "when": "paused"},
              {"verb": "delete", "confirm": true, "command": "deck.project_delete", "params": {"project": "=name"}, "when": "!builtin"}
            ]},
          {"type": "table", "title": "Commands", "source": {"from": "deck.commands_list", "where": "tool == ''", "sort": "name"},
            "description": "What the module can do and when it runs by itself.",
            "columns": [
              {"label": "Command", "bind": "title"},
              {"label": "When", "bind": "cron ?? ''", "format": "cron"}
            ],
            "actions": [
              {"verb": "run_now", "command": "deck.trigger_run", "params": {"trigger": "=trigger"}, "when": "(trigger ?? 0) != 0"},
              {"verb": "resume", "command": "deck.trigger_pause", "params": {"trigger": "=trigger", "paused": "false"}, "when": "(trigger ?? 0) != 0 && (own_paused ?? false)"},
              {"verb": "pause", "command": "deck.trigger_pause", "params": {"trigger": "=trigger", "paused": "true"}, "when": "(trigger ?? 0) != 0 && !(own_paused ?? false)"},
              {"verb": "try", "screen": "settings", "params": {"dialog": "try-command", "command": "=name"}, "when": "executor != ''"}
            ]},
          {"type": "table", "title": "Models", "when": "len(rows) > 0", "source": {"from": "deck.models_list", "rows": "work"},
            "description": "The model each command and each kind of work of its scripts runs on; pick one here for this module.",
            "columns": [
              {"label": "What", "bind": "command != nil ? title : role"},
              {"label": "Model", "bind": "model ?? ''", "pick": "model"},
              {"label": "Chosen", "bind": "own ? 'here' : 'default'", "format": "tag", "tone": "own ? 'ok' : 'muted'"},
              {"label": "Price", "bind": "price ?? ''"},
              {"label": "Why not the first", "bind": "why ?? ''", "tone": "(why ?? '') != '' ? 'warn' : ''"}
            ],
            "actions": [
              {"label": "Health", "icon": "heartbeat", "screen": "settings", "params": {"tab": "Health"}, "when": "(why ?? '') != ''"},
              {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command ?? ''"},
                "input": "model", "options": "=choices", "when": "len(choices ?? []) > 0"}
            ]}
      ]},
      {"title": "Access", "icon": "key", "blocks": [
          {"type": "dialog", "name": "folder", "title": "Add a folder", "icon": "folder-plus", "primary": true, "blocks": [
            {"type": "form", "command": "deck.folder_add"}]},
          {"type": "dialog", "name": "secret", "title": "Set a secret", "icon": "key", "blocks": [
            {"type": "form", "command": "deck.secret_set", "values": {"name": "=param.name"}}]},
          {"type": "table", "title": "Folders", "source": {"from": "deck.folders_list"},
            "description": "Folders on disk its agent commands work in, such as a repository; only you add one.",
            "empty": "No folders; add one for commands that work on the files of a repository",
            "columns": [
              {"label": "Name", "bind": "name"},
              {"label": "Path", "bind": "path", "format": "copy"}
            ],
            "actions": [
              {"verb": "remove", "confirm": true, "command": "deck.folder_remove", "params": {"name": "=name"}}
            ]},
          {"type": "table", "title": "Secrets", "when": "len(rows) > 0", "source": {"from": "deck.secrets_list"},
            "description": "Keys and passwords its tools need; its agents and scripts never see them.",
            "columns": [
              {"label": "Secret", "bind": "name", "format": "copy"},
              {"label": "State", "bind": "set ? 'set' : 'not set'", "format": "tag", "tone": "set ? 'ok' : 'warn'"}
            ],
            "actions": [
              {"verb": "replace", "screen": "settings", "params": {"dialog": "secret", "name": "=name"}, "when": "set"},
              {"verb": "set", "primary": true, "screen": "settings", "params": {"dialog": "secret", "name": "=name"}, "when": "!set"}
            ]}
      ]},
      {"title": "Health", "icon": "heartbeat", "blocks": [
          {"type": "table", "title": "Health", "source": {"from": "deck.health_list"}, "filter": ["kind", "status"],
            "description": "What deck checks of the module, with why one fails.",
            "columns": [
              {"label": "What", "bind": "subject"},
              {"label": "Status", "bind": "status", "format": "tag", "details": "error", "tone": "status == 'ok' ? 'ok' : status == 'error' ? 'error' : 'warn'"},
              {"label": "Model", "bind": "model ?? ''", "pick": "model"},
              {"label": "Since", "bind": "updated_at", "format": "relative"}
            ],
            "actions": [
              {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command"}, "input": "model", "options": "=choices", "when": "len(choices ?? []) > 0"},
              {"verb": "run_now", "command": "deck.trigger_run", "params": {"trigger": "=trigger"}, "when": "(trigger ?? 0) != 0"},
              {"verb": "check", "command": "deck.programs_check", "when": "hasPrefix(subject, 'command:') && status != 'ok'"}
            ]},
          {"type": "table", "title": "Failed runs", "empty": "No schedule failed its last run", "source": {"from": "deck.triggers_list", "where": "(last_tone ?? '') == 'error'", "sort": "command"},
            "description": "What runs by itself and failed its last run; change its model and run it again.",
            "columns": [
              {"label": "Command", "bind": "command"},
              {"label": "Model", "bind": "model ?? ''", "pick": "model"},
              {"label": "Last result", "bind": "last_word ?? ''", "format": "tag", "tone": "last_tone ?? ''"}
            ],
            "actions": [
              {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command"}, "input": "model", "options": "=choices", "when": "len(choices ?? []) > 0"},
              {"verb": "run_now", "primary": true, "command": "deck.trigger_run", "params": {"trigger": "=id"}, "when": "kind == 'cron'"},
              {"verb": "open", "screen": "process", "project": "", "record": "=last_process", "when": "last_process != 0"}
            ]}
      ]},
      {"title": "Files", "icon": "files", "blocks": [{"type": "media", "title": "Files", "span": "full", "source": {"from": "deck.files_list", "sort": "-created_at"}, "description": "What the module made and keeps: pictures, video, sound, documents of its runs and records.", "empty": "The module has no files yet", "item": {"file": "id", "title": "name"}, "actions": [{"verb": "delete", "command": "deck.file_delete", "params": {"file": "=id"}, "undo": {"command": "deck.file_restore", "params": {"file": "=id", "owner_kind": "=owner_kind", "owner_id": "=owner_id"}}}]}]},
      {"title": "Advanced", "icon": "adjustments", "blocks": [
          {"type": "table", "title": "Model calls", "when": "len(rows) > 0", "source": {"from": "deck.spend_list", "sort": "-last_at"},
            "description": "Which model each command called, how often and what it cost.",
            "columns": [
              {"label": "Command", "bind": "command"},
              {"label": "Model", "bind": "provider", "format": "tag"},
              {"label": "Paid", "bind": "subscription ? nil : cost_usd", "format": "money", "currency": "USD"},
              {"label": "Calls", "bind": "calls"},
              {"label": "Last", "bind": "last_at", "format": "relative"},
              {"label": "Subscription", "bind": "subscription ? '✓' : ''"}
            ]},
          {"type": "table", "title": "Tools", "when": "len(rows) > 0", "description": "The web addresses, MCP servers and browser its manifest calls.", "source": {"from": "deck.commands_list", "where": "tool != ''", "sort": "name"},
            "columns": [
              {"label": "Tool", "bind": "name", "format": "copy"},
              {"label": "Kind", "bind": "tool", "format": "tag"},
              {"label": "What it does", "bind": "description"}
            ]},
          {"type": "table", "title": "Tokens with access", "when": "len(rows) > 0", "description": "Automation tokens that may call its commands.", "source": {"from": "deck.tokens_list", "sort": "-id"},
            "columns": [
              {"label": "Name", "bind": "name"},
              {"label": "Commands", "bind": "join(commands, ', ')"},
              {"label": "State", "bind": "revoked ? 'revoked' : 'live'", "format": "tag", "tone": "revoked ? 'muted' : 'ok'"}
            ],
            "actions": [{"verb": "revoke", "confirm": true, "command": "deck.token_revoke", "params": {"token": "=id"}, "when": "!revoked"}]}
      ]}
    ]}
  ]
}
