{
  "name": "settings",
  "icon": "adjustments",
  "title": "Settings",
  "params": {"name": "string", "command": "string", "folder": "string", "path": "string", "node": "string"},
  "blocks": [
    {"type": "tabs", "tabs": [
      {"title": "Module", "icon": "box", "blocks": [
          {"type": "dialog", "name": "try-command", "title": "Try a command", "icon": "flask", "blocks": [
            {"type": "form", "command": "deck.command_try", "keep_open": true, "values": {"command": "=param.command"},
              "description": "Runs a command once to see what it does: its calls outside deck are declined, and a paid model waits for your yes.",
              "choices": {"command": {"source": {"from": "deck.commands_list", "where": "executor != 'tool' && executor != ''", "sort": "name"}, "value": "name", "label": "title + ' (' + name + ')'"}}}]},
          {"type": "list", "title": "Module", "icon": "box", "source": {"from": "deck.projects_list"},
            "item": {"title": "title", "icon": "icon != '' ? icon : 'box'", "text": "manifest_error != '' ? 'manifest: ' + manifest_error : description",
              "meta": "(title != name ? name + ' · ' : '') + meta",
              "tone": "manifest_error != '' ? 'error' : paused ? 'muted' : status == 'draft' ? 'warn' : ''"},
            "actions": [
              {"verb": "enable", "primary": true, "command": "deck.project_enable", "params": {"project": "=name", "revision": "=revision"}, "when": "manifest_error == '' && status == 'draft'"},
              {"verb": "pause", "command": "deck.project_pause", "params": {"project": "=name", "paused": "true"}, "when": "!paused"},
              {"verb": "resume", "command": "deck.project_pause", "params": {"project": "=name", "paused": "false"}, "when": "paused"},
              {"verb": "export", "command": "deck.project_export", "params": {"project": "=name"}, "download": true, "when": "!builtin"},
              {"label": "Export with data", "icon": "database-export", "command": "deck.project_export", "params": {"project": "=name", "data": "true"}, "download": true, "when": "!builtin"},
              {"label": "Reset the data", "icon": "eraser", "confirm": true, "command": "deck.project_reset", "params": {"project": "=name"}, "when": "!builtin"},
              {"verb": "delete", "confirm": true, "command": "deck.project_delete", "params": {"project": "=name"}, "when": "!builtin"}
            ]},
          {"type": "dialog", "name": "cover", "title": "Upload a cover", "icon": "photo-up", "blocks": [
            {"type": "form", "command": "deck.project_cover_set", "fixed": ["remove"], "description": "A picture for the card of the module: for one theme or for every theme, one for the light scheme, one for the dark."}]},
          {"type": "dialog", "name": "draw-cover", "title": "Draw the cover for this theme", "icon": "sparkles", "blocks": [
            {"type": "form", "command": "deck.cover_draw", "fixed": ["project"], "values": {"project": "=param.name"},
              "description": "The master draws the pictures of the schemes of the theme in use in its mood. Without a model it takes a free one of deck.",
              "choices": {"model": {"source": {"from": "deck.models_list", "rows": "models", "where": "kind == 'image'"}, "value": "name", "label": "name + (free ? ' · free' : '')"}}}]},
          {"type": "media", "title": "Covers", "icon": "photo", "collapsed": true, "description": "The picture of the module's card in each theme, light and dark; the card shows the one of the theme in use, else one for every theme, else any.",
            "source": {"from": "deck.project_covers_list"},
            "item": {"file": "file", "title": "title + ' · ' + (scheme == 'dark' ? 'dark scheme' : 'light scheme') + (shown ? ' · ' + 'on the card' : '')"},
            "empty": "The card has no picture yet: it shows the icon of the module.",
            "actions": [
              {"verb": "delete", "confirm": true, "command": "deck.project_cover_set", "params": {"project": "=project", "theme": "=theme", "scheme": "=scheme", "remove": "true"}}
            ]},
          {"type": "table", "title": "What runs by itself", "icon": "repeat", "source": {"from": "deck.triggers_list", "sort": "order"},
            "description": "In the order of a day: each command by the time it runs, and under it the commands that run after it, in their order; its model is picked in its row.",
            "columns": [
              {"label": "What", "bind": "step > 0 ? repeat('\u00a0\u00a0', step - 1) + '↳ ' + title : title"},
              {"label": "Model", "bind": "model ?? ''", "pick": "model", "format": "logo"},
              {"label": "When", "bind": "kind == 'cron' ? spec : every ?? spec", "format": "cron"},
              {"label": "Result", "bind": "paused || draft || (held ?? false) ? word : last_word ?? ''", "format": "tag",
                "tone": "paused || draft || (held ?? false) ? 'muted' : (failure ?? '') != '' ? 'error' : last_tone ?? ''", "details": "(failure ?? '') != '' ? failure : last_at ?? nil"}
            ],
            "actions": [
              {"verb": "run_now", "command": "deck.trigger_run", "params": {"trigger": "=id"}, "when": "kind == 'cron'"},
              {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command"}, "input": "model", "options": "=choices", "groups": "=choice_groups", "notes": "=choice_notes ?? nil", "logos": "=choice_logos ?? nil", "when": "len(choices ?? []) > 0"},
              {"verb": "pause", "command": "deck.trigger_pause", "params": {"trigger": "=id", "paused": "true"}, "when": "!paused && !draft"},
              {"verb": "resume", "command": "deck.trigger_pause", "params": {"trigger": "=id", "paused": "false"}, "when": "own_paused"},
              {"verb": "open", "screen": "process", "project": "", "record": "=last_process", "when": "last_process != 0"}
            ]},
          {"type": "list", "title": "Commands", "icon": "terminal-2", "cards": true, "collapsed": true,
            "source": {"from": "deck.commands_list", "input": {"fields": ["name", "title", "description", "executor", "tool", "cron", "document", "model"]}, "where": "tool == ''", "sort": "name"},
            "description": "What the module can do; try one, or open the file of its script or prompt.",
            "item": {"title": "title", "text": "description ?? ''", "meta": "(cron ?? '') != '' ? 'by schedule' : executor", "logo": "logo ?? model ?? ''"},
            "actions": [
              {"verb": "try", "screen": "settings", "params": {"dialog": "try-command", "command": "=name"}, "when": "executor != ''"},
              {"label": "Open the file", "icon": "file-code", "screen": "document", "record": "=document", "when": "(document ?? 0) != 0"}
            ]},
          {"type": "list", "title": "Models", "icon": "cpu", "cards": true, "source": {"from": "deck.models_list", "rows": "work"},
            "description": "The model each command and each kind of work of its scripts runs on; change it on its card.",
            "item": {"title": "command != nil ? title : role", "text": "join(filter([model ?? '', price ?? ''], # != ''), ' · ')", "meta": "own ? 'chosen here' : 'default'", "logo": "logo ?? model ?? ''",
              "details": "(why ?? '') != '' ? why : (left_out ?? '') != '' ? left_out : len(models ?? []) > 1 ? join(models[1:], ' → ') : nil",
              "tone": "(why ?? '') != '' ? 'warn' : nil"},
            "actions": [
              {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command ?? ''"},
                "input": "model", "options": "=choices", "groups": "=choice_groups", "notes": "=choice_notes ?? nil", "logos": "=choice_logos ?? nil", "when": "len(choices ?? []) > 0"},
              {"label": "Health", "icon": "heartbeat", "screen": "settings", "params": {"tab": "Health"}, "when": "(why ?? '') != ''"}
            ]}
      ]},
      {"title": "Access", "icon": "key", "blocks": [
          {"type": "dialog", "name": "folder", "title": "Add a folder", "icon": "folder-plus", "primary": true, "blocks": [
            {"type": "form", "command": "deck.folder_add",
              "choices": {"node": {"source": {"from": "deck.devices_list", "where": "kind == 'node' && !revoked"}, "value": "name"}}}]},
          {"type": "dialog", "name": "edit-folder", "title": "Change the folder", "icon": "folder-cog", "blocks": [
            {"type": "form", "command": "deck.folder_add", "fixed": ["name", "node", "replace"],
              "values": {"name": "=param.folder", "path": "=param.path", "node": "=param.node", "replace": "=true"},
              "description": "Another path for this folder; its agent commands work in the new one from their next run."}]},
          {"type": "dialog", "name": "secret", "title": "Set a secret", "icon": "key", "blocks": [
            {"type": "form", "command": "deck.secret_set", "values": {"name": "=param.name"}}]},
          {"type": "list", "title": "Folders", "icon": "folder", "cards": true, "source": {"from": "deck.folders_list"},
            "description": "Folders on disk its agent commands work in, such as a repository, on deck's machine or on that of a node; only you add one.",
            "empty": "No folders; add one for commands that work on the files of a repository",
            "item": {"title": "name", "text": "path", "meta": "join(filter([node != '' ? node : 'deck', repo ? 'git' : ''], # != ''), ' · ')", "icon": "repo ? 'git-branch' : 'folder'"},
            "actions": [
              {"verb": "edit", "screen": "settings", "params": {"dialog": "edit-folder", "folder": "=name", "path": "=path", "node": "=node"}},
              {"verb": "remove", "confirm": true, "command": "deck.folder_delete", "params": {"name": "=name", "node": "=node"}}
            ]},
          {"type": "table", "title": "Secrets", "icon": "key", "source": {"from": "deck.secrets_list"},
            "description": "Keys and passwords its tools need.",
            "empty": "No secrets: set one its tools need with Set a secret",
            "columns": [
              {"label": "Secret", "bind": "name", "format": "copy"},
              {"label": "State", "bind": "!named ? 'not named by the manifest' : set ? 'set' : 'not set'", "format": "tag", "tone": "!named ? '' : set ? 'ok' : 'warn'"},
              {"label": "Changed", "bind": "changed_at ?? ''", "format": "relative"}
            ],
            "actions": [
              {"verb": "replace", "screen": "settings", "params": {"dialog": "secret", "name": "=name"}, "when": "set"},
              {"verb": "set", "primary": true, "screen": "settings", "params": {"dialog": "secret", "name": "=name"}, "when": "!set"},
              {"verb": "delete", "confirm": true, "command": "deck.secret_delete", "params": {"name": "=name"}, "when": "set"}
            ]}
      ]},
      {"title": "Health", "icon": "heartbeat", "blocks": [
          {"type": "list", "title": "Health", "icon": "heartbeat", "cards": true, "source": {"from": "deck.health_list"}, "filter": ["kind", "status"],
            "description": "What deck checks of the module, with why one fails.",
            "item": {"title": "subject == kind ? kind : subject", "text": "error ?? ''", "since": "updated_at", "logo": "logo ?? model ?? ''",
              "meta": "model ?? ''", "tone": "status == 'ok' ? 'ok' : status == 'error' ? 'error' : 'warn'",
              "icon": "status == 'ok' ? 'circle-check' : 'alert-triangle'"},
            "actions": [
              {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command"}, "input": "model", "options": "=choices", "groups": "=choice_groups", "notes": "=choice_notes ?? nil", "logos": "=choice_logos ?? nil", "when": "len(choices ?? []) > 0"},
              {"verb": "run_now", "command": "deck.trigger_run", "params": {"trigger": "=trigger"}, "when": "(trigger ?? 0) != 0"},
              {"verb": "check", "command": "deck.program_check", "when": "hasPrefix(subject, 'command:') && status != 'ok'"}
            ]},
          {"type": "list", "title": "Failed runs", "icon": "alert-triangle", "cards": true, "empty": "No schedule failed its last run", "source": {"from": "deck.triggers_list", "where": "(failure ?? '') != ''", "sort": "command"},
            "description": "What runs by itself and failed its last run; change its model and run it again.",
            "item": {"title": "title", "text": "failure", "meta": "model ?? ''", "logo": "logo ?? model ?? ''", "tone": "'error'", "icon": "'alert-triangle'"},
            "actions": [
              {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command"}, "input": "model", "options": "=choices", "groups": "=choice_groups", "notes": "=choice_notes ?? nil", "logos": "=choice_logos ?? nil", "when": "len(choices ?? []) > 0"},
              {"verb": "run_now", "primary": true, "command": "deck.trigger_run", "params": {"trigger": "=id"}, "when": "kind == 'cron'"},
              {"verb": "open", "screen": "process", "project": "", "record": "=last_process", "when": "last_process != 0"}
            ]}
      ]},
      {"title": "Advanced", "icon": "adjustments", "blocks": [
          {"type": "table", "title": "Model calls", "icon": "message-chatbot", "when": "len(rows) > 0", "source": {"from": "deck.spend_list", "sort": "-last_at"},
            "description": "Which model each command called, how often and what it cost.",
            "columns": [
              {"label": "Command", "bind": "command"},
              {"label": "Model", "bind": "provider", "format": "tag"},
              {"label": "Paid", "bind": "subscription ? nil : cost_usd", "format": "money", "currency": "USD"},
              {"label": "Calls", "bind": "calls"},
              {"label": "Last", "bind": "last_at", "format": "relative"},
              {"label": "Subscription", "bind": "subscription ? '✓' : ''"}
            ]},
          {"type": "table", "title": "Tools", "icon": "tool", "when": "len(rows) > 0", "description": "The web addresses, MCP servers and browser its manifest calls.", "source": {"from": "deck.commands_list", "where": "tool != ''", "sort": "name"},
            "columns": [
              {"label": "Tool", "bind": "name", "format": "copy"},
              {"label": "Kind", "bind": "tool", "format": "tag"},
              {"label": "What it does", "bind": "description"}
            ]},
          {"type": "table", "title": "Tokens with access", "icon": "lock-access", "when": "len(rows) > 0", "description": "Automation tokens that may call its commands.", "source": {"from": "deck.tokens_list", "sort": "-id"},
            "columns": [
              {"label": "Name", "bind": "name"},
              {"label": "Commands", "bind": "join(commands, ', ')"},
              {"label": "State", "bind": "revoked ? 'revoked' : 'live'", "format": "tag", "tone": "revoked ? 'muted' : 'ok'"}
            ],
            "actions": [{"verb": "revoke", "confirm": true, "command": "deck.token_revoke", "params": {"token": "=id"}, "when": "!revoked"}]}
      ]}
    ]}
  ]
}
