{
  "name": "settings",
  "icon": "settings",
  "title": "Settings",
  "params": {"name": "string", "command": "string", "agent": "string", "url": "string", "model": "string", "connection": "string", "kind": "string", "role": "string", "project": "string", "models": "string", "api": "string", "local": "boolean", "node": "string", "free": "boolean", "subscription": "boolean", "input_usd": "number", "output_usd": "number", "call_usd": "number", "unit": "string", "options": "string", "tpm": "number", "context": "number"},
  "blocks": [
    {"type": "tabs", "tabs": [
      {"title": "Models", "icon": "cpu", "blocks": [
        {"type": "dialog", "name": "model", "title": "Add a model", "icon": "plus", "primary": true, "blocks": [
          {"type": "form", "command": "deck.model_set", "description": "A model of a connection; its kind and price come from the connection's catalog when left out. A model of the connection claude-code or codex runs agent turns in that CLI on the subscription, its effort in options, such as {\"effort\": \"low\"}.",
            "values": {"connection": "=param.connection", "model": "=param.model", "name": "=param.name", "kind": "=param.kind", "agent": "=param.agent", "free": "=param.free", "subscription": "=param.subscription",
              "input_usd": "=param.input_usd", "output_usd": "=param.output_usd", "call_usd": "=param.call_usd", "unit": "=param.unit", "options": "=param.options",
              "tpm": "=param.tpm", "context": "=param.context"},
            "choices": {"connection": {"source": {"from": "deck.models_list", "rows": "connections"}, "value": "name"},
              "agent": {"source": {"from": "deck.models_list", "rows": "agents", "where": "status != 'missing' && status != 'off'"}, "value": "name", "logo": "name"}}}]},
        {"type": "dialog", "name": "connections", "title": "Add a connection", "icon": "plug", "blocks": [
          {"type": "form", "command": "deck.connection_set", "description": "The address of a model API and its key, kept apart from modules. A server of a Mac on 127.0.0.1 is reached through its node.",
            "values": {"name": "=param.name", "api": "=param.api", "url": "=param.url", "local": "=param.local", "node": "=param.node"},
            "choices": {"node": {"source": {"from": "deck.devices_list", "where": "kind == 'node' && !revoked"}, "value": "name"}}}]},
        {"type": "dialog", "name": "assign", "title": "Fallbacks", "icon": "list-numbers", "blocks": [
          {"type": "form", "command": "deck.assignment_set", "description": "The first model does the work; the next ones take it while the first is down or refuses.",
            "values": {"role": "=param.role", "project": "=param.project", "command": "=param.command", "models": "=(param.models ?? '') != '' ? split(param.models, ',') : nil"},
            "choices": {"models": {"source": {"from": "deck.models_list", "rows": "models", "where": "(param.role ?? '') == '' || param.role in roles"}, "value": "name", "note": "note ?? nil", "logo": "logo", "group": "provider"}}}]},
        {"type": "list", "title": "Waiting for you", "icon": "bell", "source": {"from": "deck.models_list", "rows": "waits"},
          "empty": "All works: the models answer and the agents are signed in",
          "item": {"title": "title", "text": "text ?? ''", "icon": "icon", "tone": "tone", "logo": "logo ?? ''", "details": "why ?? nil"},
          "actions": [
            {"verb": "sign_in", "primary": true, "command": "deck.agent_login", "params": {"provider": "=agent"}, "when": "kind == 'sign_in'"},
            {"verb": "replace", "primary": true, "command": "deck.model_replace", "params": {"model": "=model", "role": "=role"}, "input": "to", "options": "=choices", "groups": "=groups", "notes": "=notes ?? nil", "logos": "=logos ?? nil", "when": "kind == 'down'"},
            {"label": "Health", "icon": "heartbeat", "screen": "settings", "params": {"tab": "Health"}, "when": "kind == 'down'"},
            {"label": "Add the key", "icon": "key", "primary": true, "screen": "settings", "params": {"tab": "Models", "dialog": "connections", "name": "=connection.name", "api": "=connection.api", "url": "=connection.url", "local": "=connection.local", "node": "=connection.node ?? ''"}, "when": "kind == 'key'"},
            {"label": "Devices", "icon": "devices", "primary": true, "screen": "settings", "params": {"tab": "Devices"}, "when": "kind == 'node'"},
            {"label": "Agents", "icon": "robot", "primary": true, "screen": "settings", "params": {"tab": "Advanced"}, "when": "kind == 'install'"}
          ]},
        {"type": "table", "title": "Sign in to agents", "icon": "login", "source": {"from": "deck.agent_logins_list"},
          "empty": "No sign-in waits; Sign in on an agent that needs one gives its link here",
          "description": "Open the link, sign in there and enter the code; the self-check runs once the agent is signed in. The sign-in stays in deck's machine.",
          "columns": [
            {"label": "Agent", "bind": "provider"},
            {"label": "Link", "bind": "url", "format": "link"},
            {"label": "Code", "bind": "code ?? ''", "format": "copy"},
            {"label": "Status", "bind": "(error ?? '') != '' ? error : paste ? 'Waits for the code of the page' : 'Waits for the sign-in'", "tone": "(error ?? '') != '' ? 'error' : 'warn'"}
          ],
          "actions": [
            {"label": "Enter the code", "icon": "key", "command": "deck.agent_login_finish", "params": {"provider": "=provider"}, "input": "code", "when": "paste && (error ?? '') == ''"},
            {"verb": "sign_in", "command": "deck.agent_login", "params": {"provider": "=provider"}, "when": "(error ?? '') != ''"}
          ]},
        {"type": "list", "title": "Who does what", "icon": "route", "cards": true, "source": {"from": "deck.models_list", "rows": "work"}, "filter": ["kind", "project", "model"],
          "description": "Each module's work and its model; change it on its card. Agent work needs an agent: Claude Code, Codex or Goose on your model.",
          "empty": "Nothing of deck runs on a model yet",
          "item": {"title": "title", "text": "model ?? ''", "meta": "price ?? ''", "group": "project_title ?? 'deck'", "logo": "logo ?? model ?? ''",
            "details": "(why ?? '') != '' ? why : (left_out ?? '') != '' ? left_out : len(models ?? []) > 1 ? join(models[1:], ' → ') : nil",
            "tone": "(why ?? '') != '' ? 'warn' : nil"},
          "actions": [
            {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project != '' ? project : nil", "command": "=command ?? nil"},
              "input": "model", "options": "=choices", "groups": "=choice_groups", "notes": "=choice_notes ?? nil", "logos": "=choice_logos ?? nil", "when": "len(choices ?? []) > 0"},
            {"verb": "fallbacks", "screen": "settings", "params": {"tab": "Models", "dialog": "assign", "role": "=role", "project": "=project", "command": "=command ?? ''", "models": "=join(models ?? [], ',')"}, "when": "len(choices ?? []) > 0"},
            {"verb": "remove", "confirm": true, "command": "deck.assignment_set", "params": {"role": "=role"}, "when": "kind == 'default' && own"}
          ]},
        {"type": "list", "title": "Models in use", "icon": "cpu", "collapsed": true, "cards": true, "source": {"from": "deck.models_list", "rows": "models", "where": "used"}, "filter": ["kind", "connection", "status"],
          "description": "By provider; a model's details say where it works.",
          "empty": "No model does any work yet",
          "item": {"title": "name", "text": "join(filter([used_in ?? '', price], # != ''), ' · ')", "meta": "agent != nil && agent != '' ? 'agent, with tools' : kind == 'text' ? 'text, one answer' : kind", "group": "provider",
            "logo": "logo",
            "details": "(error ?? '') != '' ? error : len(places ?? []) > 0 ? join(places, '; ') : status == nil ? 'No work has gone to it yet' : nil",
            "tone": "status == 'ok' ? 'ok' : status == 'error' ? 'error' : status == 'missing' || status == 'off' ? 'muted' : status != nil ? 'warn' : nil"},
          "actions": [
            {"verb": "sign_in", "command": "deck.agent_login", "params": {"provider": "=name"}, "when": "builtin && (status == 'needs_login' || status == 'error' || status == 'warning')"},
            {"verb": "check", "command": "deck.provider_check", "params": {"provider": "=name"}, "when": "(agent ?? '') != '' && status != 'missing'"},
            {"verb": "check", "command": "deck.model_call", "params": {"kind": "tts", "model": "=name", "text": "This is a short check of the voice."}, "when": "kind == 'tts'"},
            {"verb": "check", "command": "deck.model_call", "params": {"kind": "text", "model": "=name", "prompt": "This is a short check of the model: reply with the one word ok."}, "when": "kind == 'text' && (agent ?? '') == ''"},
            {"verb": "turn_off", "command": "deck.provider_switch", "params": {"provider": "=name", "off": "true"}, "when": "builtin && status != 'off' && status != 'missing'"},
            {"verb": "turn_on", "command": "deck.provider_switch", "params": {"provider": "=name", "off": "false"}, "when": "builtin && status == 'off'"},
            {"verb": "edit", "screen": "settings", "params": {"tab": "Models", "dialog": "model", "name": "=name", "connection": "=connection", "model": "=model", "kind": "=kind", "agent": "=agent ?? ''", "free": "=free", "subscription": "=subscription",
              "input_usd": "=input_usd", "output_usd": "=output_usd", "call_usd": "=call_usd", "unit": "=unit", "options": "=options ?? ''", "tpm": "=tpm ?? 0", "context": "=context ?? 0"}, "when": "!builtin"},
            {"verb": "remove", "confirm": true, "command": "deck.model_delete", "params": {"name": "=name"}, "when": "!builtin"}
          ]},
        {"type": "list", "title": "Models not in use", "icon": "archive", "collapsed": true, "cards": true, "source": {"from": "deck.models_list", "rows": "models", "where": "!used"}, "filter": ["kind", "connection", "status"],
          "description": "No work goes to these: assign one in Who does what, or remove it. For agent work, add a text model again with the agent goose.",
          "empty": "Every model does some work",
          "item": {"title": "name", "text": "price", "meta": "agent != nil && agent != '' ? 'agent, with tools' : kind == 'text' ? 'text, one answer' : kind", "group": "provider",
            "logo": "logo",
            "details": "(error ?? '') != '' ? error : status == nil ? 'No work has gone to it yet' : nil",
            "tone": "status == 'error' ? 'error' : 'muted'"},
          "actions": [
            {"verb": "check", "command": "deck.provider_check", "params": {"provider": "=name"}, "when": "(agent ?? '') != '' && status != 'missing'"},
            {"verb": "check", "command": "deck.model_call", "params": {"kind": "text", "model": "=name", "prompt": "This is a short check of the model: reply with the one word ok."}, "when": "kind == 'text' && (agent ?? '') == ''"},
            {"verb": "turn_on", "command": "deck.provider_switch", "params": {"provider": "=name", "off": "false"}, "when": "builtin && status == 'off'"},
            {"verb": "edit", "screen": "settings", "params": {"tab": "Models", "dialog": "model", "name": "=name", "connection": "=connection", "model": "=model", "kind": "=kind", "agent": "=agent ?? ''", "free": "=free", "subscription": "=subscription",
              "input_usd": "=input_usd", "output_usd": "=output_usd", "call_usd": "=call_usd", "unit": "=unit", "options": "=options ?? ''", "tpm": "=tpm ?? 0", "context": "=context ?? 0"}, "when": "!builtin"},
            {"verb": "remove", "confirm": true, "command": "deck.model_delete", "params": {"name": "=name"}, "when": "!builtin"}
          ]},
        {"type": "list", "title": "Connections", "icon": "plug", "collapsed": true, "cards": true, "source": {"from": "deck.models_list", "rows": "connections"},
          "description": "An API on the web, a server of deck's machine, or one of a Mac through its node (deck pair --node). claude-code@Mac is Claude Code on that Mac, by its sign-in.",
          "empty": "No connections yet: add one with the address of a model API and its key",
          "item": {"title": "name", "text": "where", "meta": "api == 'cli' ? '' : key == 'set' ? 'Key set' : 'No key'", "logo": "name + ' ' + url",
            "details": "api == 'cli' ? nil : url",
            "tone": "(node ?? '') != '' && !online ? 'warn' : nil"},
          "actions": [
            {"verb": "edit", "screen": "settings", "params": {"tab": "Models", "dialog": "connections", "name": "=name", "api": "=api", "url": "=url", "local": "=local", "node": "=node ?? ''"}, "when": "api != 'cli'"},
            {"verb": "remove", "confirm": true, "command": "deck.connection_delete", "params": {"name": "=name"}, "when": "models == 0 && api != 'cli'"}
          ]}
      ]},
      {"title": "Modules", "icon": "folders", "blocks": [
        {"type": "dialog", "name": "create-project", "title": "Create module", "icon": "plus", "primary": true, "blocks": [
          {"type": "form", "command": "deck.project_create", "values": {"name": "=param.name"}}]},
        {"type": "dialog", "name": "import-project", "title": "Import module", "icon": "file-import", "blocks": [
          {"type": "form", "command": "deck.project_import", "description": "A .zip of a module or a folder of this machine; it comes as a draft, and deck shows what it may do before you enable it."}]},
        {"type": "dialog", "name": "draw-cover", "title": "Draw covers", "icon": "sparkles", "blocks": [
          {"type": "form", "command": "deck.cover_draw", "values": {"project": "=param.project"},
            "description": "Deki draws the cover of the module in the mood of the theme in use, for its schemes; without a module, of every module that has none in this theme.",
            "choices": {"model": {"source": {"from": "deck.models_list", "rows": "models", "where": "kind == 'image'"}, "value": "name", "label": "name + ' · ' + price"}}}]},
        {"type": "list", "title": "Modules", "icon": "apps", "empty": "No modules yet: tell Deki what to do, or import a module", "cards": true, "source": {"from": "deck.projects_list", "sort": "name"}, "filter": ["status"],
          "head": [{"label": "Arrange the tiles", "icon": "layout-grid", "screen": "apps", "params": {"edit": "1"}}],
          "item": {"title": "title", "icon": "icon != '' ? icon : 'box'", "cover": "cover ?? (builtin ? {'light': '/deki/chill.webp', 'color': '#f4ede4', 'dark_color': '#2a2522'} : nil)", "text": "manifest_error != '' ? 'manifest: ' + manifest_error : ''",
            "meta": "status != 'enabled' || paused ? meta : ''",
            "tone": "manifest_error != '' ? 'error' : paused ? 'muted' : status == 'draft' ? 'warn' : ''"},
          "actions": [
            {"verb": "settings", "primary": true, "screen": "settings", "project": "=name", "when": "status != 'draft' || manifest_error != ''"},
            {"verb": "review", "primary": true, "screen": "draft", "params": {"project": "=name", "revision": "=revision"}, "when": "manifest_error == '' && status == 'draft'"},
            {"verb": "pause", "command": "deck.project_pause", "params": {"project": "=name", "paused": "true"}, "when": "!paused"},
            {"verb": "resume", "command": "deck.project_pause", "params": {"project": "=name", "paused": "false"}, "when": "paused"},
            {"label": "Draw a cover", "icon": "sparkles", "screen": "settings", "params": {"tab": "Modules", "dialog": "draw-cover", "project": "=name"}, "when": "!builtin"},
            {"label": "Take off the cover", "icon": "photo-off", "confirm": true, "command": "deck.project_cover_set", "params": {"project": "=name", "theme": "=cover.theme", "remove": "true"}, "when": "cover != nil"},
            {"verb": "export", "command": "deck.project_export", "params": {"project": "=name"}, "download": true, "when": "!builtin && manifest_error == ''"},
            {"label": "Export with data", "icon": "database-export", "command": "deck.project_export", "params": {"project": "=name", "data": "true"}, "download": true, "when": "!builtin && manifest_error == ''"},
            {"verb": "delete", "confirm": true, "command": "deck.project_delete", "params": {"project": "=name"}, "when": "!builtin"}
          ]},
        {"type": "table", "title": "Secrets of the modules", "icon": "key", "source": {"from": "deck.secrets_list", "sort": "project"}, "filter": ["project"],
          "description": "The secrets each module keeps apart; set, replace or delete one in the settings of its module.",
          "empty": "No module names or keeps a secret",
          "columns": [
            {"label": "Module", "bind": "project"},
            {"label": "Secret", "bind": "name"},
            {"label": "State", "bind": "!named ? 'not named by the manifest' : set ? 'set' : 'not set'", "format": "tag", "tone": "!named ? '' : set ? 'ok' : 'warn'"},
            {"label": "Changed", "bind": "changed_at ?? ''", "format": "relative"}
          ],
          "actions": [
            {"verb": "settings", "screen": "settings", "project": "=project", "params": {"tab": "Access"}}
          ]}
      ]},
      {"title": "Health", "icon": "heartbeat", "count": "failures", "blocks": [
        {"type": "list", "cards": true, "title": "Broken now", "icon": "alert-triangle", "span": "full", "source": {"from": "deck.feed_list", "input": {"kind": "failure"}},
          "empty": "Everything works",
          "item": {"title": "text", "text": "error", "since": "created_at", "tone": "'error'",
            "icon": "(process ?? 0) != 0 ? 'player-play' : 'heartbeat'",
            "meta": "join(filter([project, (repeats ?? 0) > 1 ? '×' + string(repeats) : ''], # != ''), ' · ')",
            "details": "(process ?? 0) != 0 ? '#' + string(process) + ((error_type ?? '') != '' ? ' · ' + error_type : '') : check"},
          "actions": [
            {"label": "Check again", "icon": "refresh", "primary": true, "command": "deck.provider_check", "params": {"provider": "=trimPrefix(check, 'provider:')"}, "when": "self_check ?? false"},
            {"label": "Run again", "icon": "player-play", "primary": true, "command": "deck.process_retry", "params": {"process": "=process"}, "when": "retry ?? false"},
            {"label": "Run again", "icon": "player-play", "primary": true, "command": "deck.trigger_run", "params": {"trigger": "=trigger"}, "when": "(trigger ?? 0) != 0 && (process ?? 0) == 0"},
            {"label": "Change the model", "icon": "cpu", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project != '' ? project : nil", "command": "=command ?? nil"},
              "input": "model", "options": "=choices", "groups": "=choice_groups", "when": "len(choices ?? []) > 0"},
            {"verb": "open", "screen": "process", "record": "=process", "when": "(process ?? 0) != 0"},
            {"label": "Got it", "icon": "check", "command": "deck.process_dismiss", "params": {"process": "=process"}, "when": "(process ?? 0) != 0"},
            {"verb": "open", "screen": "settings", "params": {"tab": "Advanced"}, "when": "check == 'push'"}, {"verb": "set", "primary": true, "screen": "settings", "project": "=project", "params": {"tab": "Access", "dialog": "secret", "name": "=trimPrefix(check, 'secret:' + project + '.')"}, "when": "hasPrefix(check ?? '', 'secret:')"},
            {"label": "Got it", "icon": "check", "command": "deck.health_mark_seen", "params": {"subject": "=check", "project": "=project != '' ? project : nil"}, "when": "(check ?? '') != ''"}
          ]},
        {"type": "stat", "title": "Checks that pass", "icon": "circle-check", "span": 2, "tone": "'ok'",
          "description": "Models, agents, scripts, connections, pushes and the disk: what deck checks by itself.",
          "source": {"from": "deck.health_list", "where": "status == 'ok'"},
          "actions": [{"label": "All checks", "screen": "settings", "params": {"tab": "Health", "dialog": "checks"}}]},
        {"type": "dialog", "name": "checks", "title": "All checks", "icon": "list-check", "blocks": [
          {"type": "table", "title": "Everything deck checks", "icon": "list-check", "source": {"from": "deck.health_list"}, "filter": ["kind", "status", "project"],
            "columns": [
              {"label": "What", "bind": "subject == kind ? kind : subject"},
              {"label": "Status", "bind": "status", "format": "tag", "details": "error", "tone": "status == 'ok' ? 'ok' : status == 'error' ? 'error' : 'warn'"},
              {"label": "Since", "bind": "updated_at", "format": "relative"},
              {"label": "Does", "bind": "join(places ?? [], ', ')"}
            ],
            "actions": [
              {"verb": "check", "command": "deck.provider_check", "params": {"provider": "=trimPrefix(subject, 'provider:')"}, "when": "self_check"},
              {"verb": "open", "screen": "settings", "params": {"tab": "Advanced"}, "when": "subject == 'push' && status != 'ok'"}
            ]}]}
      ]},
      {"title": "Memory", "icon": "brain", "blocks": [
        {"type": "media", "title": "What feeds what", "icon": "sitemap", "span": "full", "source": {"from": "deck.memory_map", "rows": "picture"},
          "item": {"file": "file", "title": "title"}},
        {"type": "list", "title": "Parts of memory", "icon": "brain", "span": "full", "cards": true, "source": {"from": "deck.memory_map", "rows": "nodes"},
          "item": {"title": "title", "text": "text", "meta": "meta ?? nil", "icon": "icon", "since": "at ?? nil", "details": "details ?? nil", "tone": "tone ?? nil"},
          "actions": [
            {"verb": "run_now", "confirm": true, "command": "deck.trigger_run", "params": {"trigger": "=trigger"}, "when": "(trigger ?? 0) != 0"}
          ]},
        {"type": "list", "title": "Who sleeps and reviews", "icon": "moon", "cards": true,
          "source": {"from": "deck.models_list", "rows": "work", "where": "project == 'master' && (command == 'sleep' || command == 'review')"},
          "description": "The models of sleep and the daily review; sleep starts on a free model first.",
          "empty": "Sleep and review have no model yet",
          "item": {"title": "title", "text": "model ?? ''", "meta": "price ?? ''", "logo": "logo ?? model ?? ''",
            "details": "(why ?? '') != '' ? why : (left_out ?? '') != '' ? left_out : len(models ?? []) > 1 ? join(models[1:], ' → ') : nil",
            "tone": "(why ?? '') != '' ? 'warn' : nil"},
          "actions": [
            {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command"},
              "input": "model", "options": "=choices", "groups": "=choice_groups", "notes": "=choice_notes ?? nil", "logos": "=choice_logos ?? nil", "when": "len(choices ?? []) > 0"},
            {"verb": "fallbacks", "screen": "settings", "params": {"tab": "Models", "dialog": "assign", "role": "=role", "project": "=project", "command": "=command", "models": "=join(models ?? [], ',')"}, "when": "len(choices ?? []) > 0"}
          ]},
        {"type": "list", "title": "Memory of each module", "icon": "database", "cards": true, "source": {"from": "deck.memory_map", "rows": "projects"},
          "item": {"title": "project", "text": "summary", "meta": "lines", "since": "changed ?? nil", "icon": "'database'"},
          "actions": [
            {"verb": "open", "primary": true, "screen": "document", "project": "=project", "record": "=index", "when": "index != 0"}
          ]},
        {"type": "list", "title": "Lessons", "icon": "bulb", "span": "full", "source": {"from": "deck.memory_map", "rows": "lessons"}, "filter": ["project", "command"],
          "description": "What deck's agents concluded from their runs, not your words; delete what you do not want.",
          "empty": "No lessons yet",
          "item": {"title": "name", "text": "description", "meta": "join(filter([project, command ?? '', counts], # != ''), ' · ')", "since": "changed", "details": "source", "icon": "'bulb'"},
          "actions": [
            {"verb": "open", "primary": true, "screen": "document", "project": "=project", "record": "=document"},
            {"verb": "delete", "confirm": true, "command": "deck.document_delete", "params": {"document": "=document"}}
          ]},
        {"type": "table", "title": "Repeated failures", "icon": "repeat", "span": "full", "source": {"from": "deck.memory_map", "rows": "repeats"},
          "empty": "No command failed the same way twice lately",
          "columns": [
            {"label": "Module", "bind": "project"}, {"label": "Command", "bind": "command"}, {"label": "Failure", "bind": "error_type"},
            {"label": "Failures", "bind": "failures", "format": "number"}, {"label": "Last", "bind": "last", "format": "relative"}
          ]}
      ]},
      {"title": "Devices", "icon": "devices", "blocks": [
        {"type": "dialog", "name": "pair", "title": "Pair a device", "icon": "qrcode", "blocks": [
          {"type": "form", "command": "deck.pair_link", "keep_open": true}]},
        {"type": "table", "title": "Devices", "icon": "devices", "source": {"from": "deck.devices_list", "where": "!revoked"}, "span": 2,
          "description": "Each browser you signed in from, and each node: a computer of yours that lends deck its models, agents and folders (paired by deck pair --node). Revoking one signs out only that one.",
          "columns": [
            {"label": "Name", "bind": "name"},
            {"label": "Kind", "bind": "kind == 'node' ? 'node' : passkey != '' ? 'browser' : 'pushes only'", "format": "tag", "tone": "passkey != '' || kind != 'browser' ? 'ok' : 'warn'"},
            {"label": "Passkey", "bind": "passkey"},
            {"label": "This device", "bind": "this ? 'you are here' : ''", "format": "tag", "tone": "'ok'"},
            {"label": "Pushes", "bind": "push ? 'on' : ''"},
            {"label": "Seen", "bind": "seen_at", "format": "relative"}
          ],
          "actions": [
            {"verb": "edit", "command": "deck.device_rename", "params": {"device": "=id"}, "input": "name"},
            {"verb": "revoke", "confirm": true, "command": "deck.device_revoke", "params": {"device": "=id"}, "when": "!this"},
            {"label": "Revoke this browser: you sign out for good", "icon": "ban", "confirm": true, "command": "deck.device_revoke", "params": {"device": "=id"}, "when": "this"}
          ]},
        {"type": "table", "title": "Passkeys", "icon": "fingerprint", "collapsed": true, "source": {"from": "deck.passkeys_list", "where": "!revoked"}, "span": 2,
          "description": "A passkey is the key your device keeps instead of a password (by a fingerprint or a face). One synced to several browsers signs each in as a device of its own; revoking it signs all of them out.",
          "columns": [
            {"label": "Name", "bind": "name"},
            {"label": "Address", "bind": "site"},
            {"label": "Devices", "bind": "devices"},
            {"label": "Seen", "bind": "seen_at", "format": "relative"}
          ],
          "actions": [
            {"verb": "edit", "command": "deck.passkey_rename", "params": {"passkey": "=id"}, "input": "name"},
            {"verb": "revoke", "confirm": true, "command": "deck.passkey_revoke", "params": {"passkey": "=id"}}
          ]},
        {"type": "appearance", "title": "Pushes", "icon": "bell-ringing", "part": "pushes", "span": 2,
          "description": "deck sends a push when something waits for you or a module tells you; each device turns them on for itself.",
          "actions": [
            {"label": "Get pushes here", "command": "deck.push_subscribe"},
            {"label": "Stop pushes here", "command": "deck.push_unsubscribe"}
          ]},
        {"type": "table", "title": "Text of pushes", "icon": "bell", "collapsed": true, "source": {"from": "deck.settings_list", "where": "name == 'push_text'"},
          "description": "On a locked screen a push shows its text, or only the module it is of.",
          "columns": [
            {"label": "Setting", "bind": "title"},
            {"label": "Value", "bind": "value == 'hidden' ? 'only the module' : 'the text'"}
          ],
          "actions": [
            {"label": "Hide the text", "icon": "eye-off", "command": "deck.setting_set", "params": {"name": "push_text", "value": "hidden"}, "when": "value != 'hidden'"},
            {"label": "Show the text", "icon": "eye", "command": "deck.setting_set", "params": {"name": "push_text", "value": "full"}, "when": "value == 'hidden'"}
          ]},
        {"type": "table", "title": "Pages the master reads after text from outside", "icon": "world-exclamation", "collapsed": true, "source": {"from": "deck.settings_list", "where": "name == 'master_web'"},
          "description": "After text from outside, the master asks you for each page, or reads by its right: then a page may carry out what it knows.",
          "columns": [
            {"label": "Setting", "bind": "title"},
            {"label": "Value", "bind": "value == 'always' ? 'reads by its right' : 'asks you for each page'"}
          ],
          "actions": [
            {"label": "Read by its right", "icon": "world", "confirm": true, "command": "deck.setting_set", "params": {"name": "master_web", "value": "always"}, "when": "value != 'always'"},
            {"label": "Ask me for each page", "icon": "hand-stop", "command": "deck.setting_set", "params": {"name": "master_web", "value": "ask"}, "when": "value == 'always'"}
          ]},
        {"type": "actions", "title": "Push key", "icon": "key", "collapsed": true, "description": "A new key stops the pushes of every device until each turns them on again.",
          "actions": [{"verb": "reset_push", "confirm": true, "command": "deck.push_key_reset"}]}
      ]},
      {"title": "Advanced", "icon": "adjustments", "blocks": [
        {"type": "table", "title": "deck", "icon": "info-circle", "source": {"from": "deck.health_list", "where": "subject == 'update'"},
          "description": "The version of deck and whether a newer one is out; deck looks once a day.",
          "columns": [
            {"label": "Version", "bind": "version"},
            {"label": "Status", "bind": "error != '' ? error : status", "format": "tag", "tone": "status == 'ok' ? 'ok' : 'warn'"}
          ],
          "actions": [
            {"label": "Update", "icon": "download", "command": "deck.update_install", "when": "status == 'warning'"},
            {"label": "Look for an update", "icon": "refresh", "command": "deck.update_check", "when": "version startsWith 'v'"}
          ]},
        {"type": "dialog", "name": "token", "title": "Create a token", "icon": "ticket", "blocks": [
          {"type": "form", "command": "deck.token_create", "keep_open": true,
            "choices": {"commands": {"source": {"from": "deck.commands_list", "sort": "name"}, "value": "name"}}}]},
        {"type": "table", "title": "Limits", "icon": "gauge", "source": {"from": "deck.settings_list", "where": "name != 'language' && name != 'push_text' && name != 'master_web'"},
          "description": "How much deck runs at once and how long it waits for you.",
          "columns": [
            {"label": "Setting", "bind": "title"},
            {"label": "Value", "bind": "string(value)", "pick": "edit"},
            {"label": "Default", "bind": "default"}
          ],
          "actions": [
            {"verb": "edit", "command": "deck.setting_set", "params": {"name": "=name"}, "input": "value", "options": "=options"}
          ]},
        {"type": "table", "title": "Agents", "icon": "robot", "empty": "No agent found: install Claude Code or Codex, or add an ACP agent", "source": {"from": "deck.models_list", "rows": "agents"},
          "description": "The programs agent commands run in, with their version; change them only when an agent breaks.",
          "columns": [
            {"label": "Agent", "bind": "name"},
            {"label": "Version", "bind": "version"},
            {"label": "Status", "bind": "status == 'missing' ? 'not installed' : status == 'off' ? 'turned off' : status", "format": "tag", "tone": "status == 'ok' ? 'ok' : status == 'error' ? 'error' : status == 'missing' || status == 'off' ? 'muted' : 'warn'", "details": "error"}
          ],
          "actions": [
            {"verb": "turn_off", "command": "deck.provider_switch", "params": {"provider": "=name", "off": "true"}, "when": "builtin && status != 'missing' && status != 'off'"},
            {"verb": "turn_on", "command": "deck.provider_switch", "params": {"provider": "=name", "off": "false"}, "when": "builtin && status == 'off'"}
          ]},
        {"type": "table", "title": "Automation tokens", "icon": "lock-access", "source": {"from": "deck.tokens_list", "sort": "-id"},
          "description": "A way in for Shortcuts or your scripts, to the commands it lists.",
          "empty": "No tokens yet: make one for a script or a service outside deck that calls its commands",
          "columns": [
            {"label": "Name", "bind": "name"},
            {"label": "State", "bind": "revoked ? 'revoked' : 'live'", "format": "tag", "tone": "revoked ? 'muted' : 'ok'", "details": "'POST /api/commands/<command> with Authorization: Bearer <token>'"},
            {"label": "Commands", "bind": "join(commands, ', ')"},
            {"label": "What it writes", "bind": "trusted ? 'yours' : 'from outside'", "format": "tag", "tone": "trusted ? 'ok' : 'muted'"},
            {"label": "Created", "bind": "created_at", "format": "relative"}
          ],
          "actions": [
            {"verb": "trust", "confirm": true, "command": "deck.token_trust", "params": {"token": "=id", "trusted": "true"}, "when": "!revoked && !trusted"},
            {"verb": "distrust", "command": "deck.token_trust", "params": {"token": "=id", "trusted": "false"}, "when": "!revoked && trusted"},
            {"verb": "revoke", "confirm": true, "command": "deck.token_revoke", "params": {"token": "=id"}, "when": "!revoked"}
          ]}
      ]}
    ]}
  ]
}
