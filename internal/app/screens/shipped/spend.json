{
  "name": "spend",
  "icon": "chart-bar",
  "title": "Spend",
  "params": {
    "period": {
      "type": "string",
      "default": "30 days"
    }
  },
  "side": [
    {
      "type": "filter",
      "title": "Period",
      "icon": "calendar",
      "param": "period",
      "options": [
        "Today",
        "7 days",
        "30 days"
      ]
    }
  ],
  "blocks": [
    {
      "type": "dialog",
      "name": "breakdown",
      "title": "By provider and model",
      "icon": "list-details",
      "blocks": [
        {
          "type": "table",
          "title": "By provider and model",
          "source": {
            "from": "deck.spend_days_list",
            "input": {
              "days": 30,
              "by": "provider"
            }
          },
          "description": "The last 30 days, as the numbers above.",
          "columns": [
            {
              "label": "Model",
              "bind": "provider",
              "format": "logo"
            },
            {
              "label": "Provider",
              "bind": "group ?? ''"
            },
            {
              "label": "Paid, $",
              "bind": "cost_usd",
              "format": "money",
              "currency": "USD"
            },
            {
              "label": "Tokens",
              "bind": "tokens",
              "format": "compact"
            },
            {
              "label": "On subscriptions, about $",
              "bind": "subscription_usd > 0 ? subscription_usd : nil",
              "format": "money",
              "currency": "USD"
            }
          ]
        }
      ]
    },
    {
      "type": "stat",
      "title": "Paid in 30 days",
      "icon": "coin",
      "span": 1,
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": 30
        }
      },
      "value": "sum(map(rows, .cost_usd))",
      "format": "money",
      "currency": "USD",
      "actions": [
        {
          "label": "By provider and model",
          "icon": "list-details",
          "screen": "spend",
          "params": {
            "dialog": "breakdown"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Covered by subscriptions, about",
      "icon": "rosette-discount-check",
      "span": 1,
      "tone": "'ok'",
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": 30
        }
      },
      "value": "sum(map(rows, .subscription_usd))",
      "format": "money",
      "currency": "USD",
      "description": "What the work on the subscriptions of Claude Code and Codex would cost by the prices of their models.",
      "actions": [
        {
          "label": "By provider and model",
          "icon": "list-details",
          "screen": "spend",
          "params": {
            "dialog": "breakdown"
          }
        }
      ]
    },
    {
      "type": "chart",
      "title": "Paid by day",
      "icon": "chart-bar",
      "kind": "bar",
      "span": "full",
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": "={'Today': 1, '7 days': 7, '30 days': 30}[param.period] ?? 30"
        }
      },
      "x": "day",
      "format": "money",
      "currency": "USD",
      "series": [
        {
          "label": "Paid",
          "y": "cost_usd"
        }
      ],
      "details": "models"
    },
    {
      "type": "table",
      "title": "By module",
      "icon": "apps",
      "span": 1,
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": "={'Today': 1, '7 days': 7, '30 days': 30}[param.period] ?? 30",
          "by": "project"
        },
        "sort": "-cost_usd"
      },
      "description": "Each module and what its models spent; open a row for each model's money and tokens.",
      "empty": "No model calls",
      "columns": [
        {
          "label": "Module",
          "bind": "title",
          "icon": "icon"
        },
        {
          "label": "Paid, $",
          "bind": "cost_usd == 0 && subscription_usd > 0 ? nil : cost_usd",
          "format": "money",
          "currency": "USD"
        },
        {
          "label": "Tokens",
          "bind": "tokens",
          "format": "compact"
        },
        {
          "label": "Calls",
          "bind": "calls",
          "format": "number"
        },
        {
          "label": "On subscriptions, about $",
          "bind": "subscription_usd > 0 ? subscription_usd : nil",
          "format": "money",
          "currency": "USD"
        },
        {
          "label": "By model",
          "bind": "nil",
          "details": "models ?? ''"
        }
      ]
    },
    {
      "type": "table",
      "title": "By model",
      "icon": "cpu",
      "span": 1,
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": "={'Today': 1, '7 days': 7, '30 days': 30}[param.period] ?? 30",
          "by": "provider"
        }
      },
      "empty": "No model calls",
      "columns": [
        {
          "label": "Model",
          "bind": "provider",
          "format": "logo"
        },
        {
          "label": "Paid, $",
          "bind": "cost_usd == 0 && subscription_usd > 0 ? nil : cost_usd",
          "format": "money",
          "currency": "USD"
        },
        {
          "label": "Tokens",
          "bind": "tokens",
          "format": "compact"
        },
        {
          "label": "Share",
          "bind": "share",
          "format": "percent"
        },
        {
          "label": "Calls",
          "bind": "calls",
          "format": "number"
        },
        {
          "label": "On subscriptions, about $",
          "bind": "subscription_usd > 0 ? subscription_usd : nil",
          "format": "money",
          "currency": "USD"
        },
        {
          "label": "Provider",
          "bind": "group ?? ''"
        }
      ]
    }
  ]
}
