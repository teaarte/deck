{
  "name": "spend",
  "icon": "chart-bar",
  "title": "Spend",
  "params": {
    "period": {
      "type": "string",
      "default": "Today"
    }
  },
  "side": [
    {
      "type": "filter",
      "title": "Period",
      "param": "period",
      "options": [
        "Today",
        "7 days",
        "30 days"
      ]
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "title": "Paid in 30 days",
      "icon": "coin",
      "span": 1,
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": 30
        }
      },
      "value": "sum(map(rows, .cost_usd))",
      "format": "money",
      "currency": "USD",
      "actions": [
        {
          "verb": "open",
          "screen": "spend",
          "params": {
            "period": "30 days"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Covered by subscriptions, about",
      "icon": "rosette-discount-check",
      "span": 1,
      "tone": "'ok'",
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": 30
        }
      },
      "value": "sum(map(rows, .subscription_usd))",
      "format": "money",
      "currency": "USD",
      "description": "What the work on the subscriptions of Claude Code and Codex would cost by the prices of their models.",
      "actions": [
        {
          "verb": "open",
          "screen": "spend",
          "params": {
            "period": "30 days"
          }
        }
      ]
    },
    {
      "type": "chart",
      "title": "Paid by day",
      "kind": "bar",
      "span": "full",
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": "={'Today': 1, '7 days': 7, '30 days': 30}[param.period] ?? 30"
        }
      },
      "x": "day",
      "format": "money",
      "currency": "USD",
      "series": [
        {
          "label": "Paid",
          "y": "cost_usd"
        }
      ],
      "when": "param.period != 'Today'"
    },
    {
      "type": "table",
      "title": "By module",
      "span": 1,
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": "={'Today': 1, '7 days': 7, '30 days': 30}[param.period] ?? 30",
          "by": "project"
        },
        "sort": "-cost_usd"
      },
      "description": "What each module paid for models; work on a subscription costs nothing beyond it.",
      "empty": "No model calls",
      "columns": [
        {
          "label": "Module",
          "bind": "title",
          "format": "tag"
        },
        {
          "label": "Paid",
          "bind": "cost_usd == 0 && subscription_usd > 0 ? nil : cost_usd",
          "format": "money",
          "currency": "USD"
        },
        {
          "label": "Subscription ≈",
          "bind": "subscription_usd > 0 ? subscription_usd : nil",
          "format": "money",
          "currency": "USD"
        },
        {
          "label": "Calls",
          "bind": "calls"
        },
        {
          "label": "Tokens",
          "bind": "tokens",
          "format": "compact"
        }
      ]
    },
    {
      "type": "table",
      "title": "By model",
      "span": 1,
      "source": {
        "from": "deck.spend_days_list",
        "input": {
          "days": "={'Today': 1, '7 days': 7, '30 days': 30}[param.period] ?? 30",
          "by": "provider"
        }
      },
      "empty": "No model calls",
      "columns": [
        {
          "label": "Provider",
          "bind": "group ?? ''"
        },
        {
          "label": "Model",
          "bind": "provider",
          "format": "tag"
        },
        {
          "label": "Paid",
          "bind": "cost_usd == 0 && subscription_usd > 0 ? nil : cost_usd",
          "format": "money",
          "currency": "USD"
        },
        {
          "label": "Share",
          "bind": "share",
          "format": "percent"
        },
        {
          "label": "Calls",
          "bind": "calls"
        },
        {
          "label": "Tokens",
          "bind": "tokens",
          "format": "compact"
        },
        {
          "label": "Subscription ≈",
          "bind": "subscription_usd > 0 ? subscription_usd : nil",
          "format": "money",
          "currency": "USD"
        }
      ]
    }
  ]
}
