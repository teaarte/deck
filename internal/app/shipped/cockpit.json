{
  "name": "cockpit",
  "icon": "layout-dashboard",
  "title": "Cockpit",
  "blocks": [
    {"type": "stat", "title": "Waiting for you", "icon": "hand-finger", "source": {"from": "deck.asks_list"}, "tone": "len(rows) > 0 ? 'warn' : 'muted'"},
    {"type": "stat", "title": "Running", "icon": "activity", "source": {"from": "deck.processes_list", "input": {"open": true}}, "tone": "len(rows) > 0 ? 'ok' : 'muted'",
      "actions": [{"verb": "open", "screen": "schedule", "params": {"tab": "Runs"}}]},
    {"type": "stat", "title": "Failing checks", "icon": "alert-triangle", "source": {"from": "deck.health_list"}, "value": "count(rows, .status == 'error' && !.seen)", "tone": "count(rows, .status == 'error' && !.seen) > 0 ? 'error' : 'muted'",
      "actions": [{"verb": "open", "screen": "settings", "params": {"tab": "Health"}}]},
    {"type": "stat", "title": "Runs today", "icon": "repeat", "source": {"from": "deck.runs_daily", "input": {"days": 1}}, "value": "sum(map(rows, .runs))", "tone": "'muted'",
      "actions": [{"verb": "open", "screen": "schedule", "params": {"tab": "Runs"}}]},
    {"type": "columns", "blocks": [
      {"type": "list", "title": "Needs your decision", "icon": "hand-finger", "span": 2, "when": "len(rows) > 0", "source": {"from": "deck.asks_list"},
          "description": "Nothing moves on without your answer; the time a confirmation has left is beside it.",
        "item": {"title": "what", "text": "where",
          "icon": "kind == 'question' ? 'message-question' : kind in ['sign_in', 'login'] ? 'key' : kind == 'unknown' ? 'help-triangle' : kind == 'grant' ? 'shield-check' : 'send'", "meta": "project + (who != '' ? ' · ' + who : '')", "tone": "expired ? 'muted' : 'warn'",
          "details": "kind in ['call', 'unknown', 'confirm', 'grant'] ? toJSON(payload) : ''",
          "questions": "kind == 'question' && len(payload?.questions ?? []) > 0 ? payload.questions : nil"},
        "actions": [
          {"verb": "answer", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id"}, "input": "answer", "when": "kind == 'question' && !expired"},
          {"verb": "retry", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "retry"}, "when": "kind == 'unknown' && !expired"},
          {"verb": "mark_done", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "done"}, "when": "kind == 'unknown' && !expired"},
          {"verb": "allow", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "allow"}, "until": "=expires_at", "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
          {"verb": "allow_always", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "allow_always"}, "until": "=expires_at", "when": "kind == 'call' && !expired"},
          {"verb": "deny", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
          {"verb": "deny_because", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "input": "reason", "when": "kind in ['call', 'confirm', 'grant'] && !expired"},
          {"verb": "retry", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "retry"}, "when": "kind == 'login' && !expired"},
          {"verb": "new_session", "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "new_session"}, "when": "kind == 'login' && !expired"},
          {"verb": "sign_in", "primary": true, "command": "deck.browser_login", "params": {"url": "='https://' + payload.site"}, "when": "kind == 'sign_in' && (payload?.site ?? '') != '' && !expired"},
          {"verb": "signed_in", "command": "deck.browser_login_done", "params": {"url": "='https://' + payload.site"}, "when": "kind == 'sign_in' && (payload?.site ?? '') != '' && !expired"},
          {"verb": "sign_in", "primary": true, "command": "deck.oauth_start", "params": {"tool": "=payload?.tool ?? ''"}, "when": "kind == 'sign_in' && (payload?.site ?? '') == '' && !expired"},
          {"verb": "deny", "primary": true, "command": "deck.ask_answer", "params": {"ask": "=id", "answer": "deny"}, "when": "expired"}
        ]},
      {"type": "columns", "blocks": [
        {"type": "list", "title": "Did not work", "icon": "alert-circle", "when": "len(rows) > 0",
          "source": {"from": "deck.processes_list", "input": {"failed": true, "brief": true}},
          "description": "Runs that failed and no later run made good; close one you will not repeat.",
          "item": {"title": "project + ' · ' + command + ((record_title ?? '') != '' ? ' · ' + record_title : '')", "tone": "'error'", "icon": "'alert-circle'",
            "text": "(error ?? '') != '' ? error : 'the result did not match its schema'", "meta": "'#' + string(id)"},
          "actions": [
            {"verb": "retry", "primary": true, "command": "deck.process_retry", "params": {"process": "=id"}},
            {"verb": "open", "screen": "process", "record": "=id"},
            {"verb": "close", "command": "deck.process_dismiss", "params": {"process": "=id"}}
          ]},
        {"type": "list", "title": "Running now", "icon": "activity", "when": "len(rows) > 0",
          "source": {"from": "deck.processes_list", "input": {"open": true}},
          "item": {"title": "project + ' · ' + ((topic ?? '') != '' ? topic : command) + ((record_title ?? '') != '' ? ' · ' + record_title : '')",
            "tone": "(long ?? false) ? 'warn' : ''",
            "text": "((long ?? false) ? 'longer than usual · ' : '') + ((question ?? '') != '' ? 'waits for your answer: ' + question : silent ? 'silent' : state == 'waiting_slot' ? 'waits for a slot' : state == 'waiting_folder' ? 'waits for folder ' + folder : state == 'rate_limited' ? 'paused on a usage limit' : kind == 'script' ? 'a script runs' : 'runs on ' + ((provider ?? '') != '' ? provider : kind))",
            "icon": "kind == 'script' ? 'code' : kind == 'tool' ? 'tool' : kind == 'model' ? 'sparkles' : 'robot'",
            "meta": "((seconds ?? 0) < 60 ? string(seconds ?? 0) + ' s' : (seconds ?? 0) < 3600 ? string(int((seconds ?? 0) / 60)) + ' min' : string(int((seconds ?? 0) / 3600)) + ' h') + ' · ' + ((trigger ?? 0) != 0 ? 'by schedule · #' + string(id) : (parent ?? 0) != 0 ? 'of #' + string(parent) + ' · #' + string(id) : '#' + string(id))"},
          "actions": [
            {"verb": "open", "screen": "process", "record": "=id"},
            {"verb": "stop", "command": "deck.process_stop", "params": {"process": "=id"}, "when": "(finished_at ?? '') == ''"}
          ]},
        {"type": "list", "title": "Notes", "icon": "bell", "when": "len(rows) > 0",
          "source": {"from": "deck.feed_list", "input": {"kind": "note", "unread": true}, "limit": 10},
          "item": {"title": "text", "icon": "'news'", "meta": "project + ' · ' + author"},
          "actions": [
            {"verb": "open", "screen": "=screen", "project": "=deck_screen ? '' : project", "record": "=record", "when": "screen != ''"},
            {"verb": "mark_read", "primary": true, "command": "deck.feed_read", "params": {"entry": "=id"}}
          ]},
        {"type": "list", "title": "Done without you", "icon": "checks", "when": "len(rows) > 0", "source": {"from": "deck.feed_list", "input": {"kind": "change"}, "limit": 3},
          "item": {"title": "text", "meta": "project + ' · ' + author"},
          "actions": [
            {"verb": "undo", "command": "deck.feed_undo", "params": {"entry": "=id"}, "when": "can_undo"}
          ]}
      ]}
    ]},
    {"type": "dialog", "name": "changes", "title": "All changes", "icon": "history", "blocks": [
      {"type": "table", "title": "Done without you", "source": {"from": "deck.feed_list", "input": {"kind": "change", "limit": 500}},
        "columns": [
          {"label": "What", "bind": "text"},
          {"label": "Project", "bind": "project", "format": "tag"},
          {"label": "Who", "bind": "author", "format": "tag"},
          {"label": "When", "bind": "created_at", "format": "relative"}
        ],
        "actions": [
          {"verb": "undo", "command": "deck.feed_undo", "params": {"entry": "=id"}, "when": "can_undo"}
        ]}]}
  ]
}
