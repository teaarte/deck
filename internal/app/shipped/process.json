{
  "name": "process",
  "icon": "activity",
  "title": "Process",
  "record": "process",
  "blocks": [
    {"type": "card", "fields": [
      {"label": "Project", "bind": "project", "format": "tag"},
      {"label": "Command", "bind": "command"},
      {"label": "State", "bind": "silent ? state + ', silent' : state", "format": "tag", "tone": "state == 'done' ? 'ok' : state in ['error', 'interrupted'] ? 'error' : state == 'stopped' ? 'muted' : state in ['waiting_answer', 'needs_login', 'rate_limited', 'waiting_provider'] ? 'warn' : ''"},
      {"label": "Model", "bind": "provider", "format": "tag"},
      {"label": "Started", "bind": "started_at"},
      {"label": "Error", "bind": "error"},
      {"label": "Open in a terminal", "bind": "terminal ?? ''"}
    ],
    "actions": [
      {"verb": "stop", "command": "deck.process_stop", "params": {"process": "=id"}, "when": "(finished_at ?? '') == ''"},
      {"verb": "rework", "primary": true, "command": "deck.process_rework", "params": {"process": "=id"}, "input": "remark", "when": "kind == 'agent' && (session_id ?? '') != '' && (finished_at ?? '') != ''"},
      {"verb": "tell", "command": "deck.process_tell", "params": {"process": "=id"}, "input": "text", "when": "kind == 'agent' && (finished_at ?? '') == ''"}
    ]},
    {"type": "log", "title": "Log", "source": {"from": "deck.process_log", "input": {"process": "=id"}}}
  ]
}
