{
  "name": "schedule",
  "icon": "calendar-time",
  "title": "Schedule",
  "params": {"project": "string", "command": "string", "models": "string"},
  "blocks": [
    {"type": "tabs", "tabs": [
      {"title": "Schedule", "icon": "calendar-time", "blocks": [
        {"type": "table", "title": "What runs by itself", "source": {"from": "deck.triggers_list", "sort": "project"}, "filter": ["project"],
          "description": "Each command that runs on its own, how often, and the model it runs on; a model picked here replaces the one the manifest suggests.",
          "empty": "Nothing is scheduled",
          "columns": [
            {"label": "Module", "bind": "project", "format": "tag", "tone": "paused || draft ? 'muted' : ''"},
            {"label": "Command", "bind": "command", "tone": "paused || draft ? 'muted' : ''"},
            {"label": "How often", "bind": "kind == 'cron' ? spec : kind + ' ' + spec", "format": "cron"},
            {"label": "Model", "bind": "model ?? ''", "pick": "model"},
            {"label": "Price", "bind": "price ?? ''"}
          ],
          "actions": [
            {"verb": "model", "command": "deck.assignment_set", "params": {"role": "=role", "project": "=project", "command": "=command"}, "input": "model", "options": "=choices", "when": "len(choices ?? []) > 0"},
            {"verb": "run_now", "command": "deck.trigger_run", "params": {"trigger": "=id"}, "when": "kind == 'cron'"},
            {"verb": "resume", "command": "deck.trigger_pause", "params": {"trigger": "=id", "paused": "false"}, "when": "own_paused"},
            {"verb": "pause", "command": "deck.trigger_pause", "params": {"trigger": "=id", "paused": "true"}, "when": "!own_paused"},
            {"verb": "open", "screen": "process", "record": "=last_process", "when": "last_process != 0"}
          ]}
      ]},
      {"title": "Runs", "icon": "list", "blocks": [
        {"type": "table", "title": "History", "source": {"from": "deck.processes_list", "input": {"limit": 100}, "sort": "-id"}, "filter": ["project", "state"],
          "description": "Every run, by schedule, by a button or by the master; a run shows its log and the calls it made.",
          "columns": [
            {"label": "Command", "bind": "command"},
            {"label": "Module", "bind": "project", "format": "tag"},
            {"label": "State", "bind": "word", "format": "tag", "tone": "tone ?? ''"},
            {"label": "Started", "bind": "started_at", "format": "relative"},
            {"label": "By", "bind": "kind == 'script' ? 'script' : (provider ?? '') != '' ? provider : kind", "format": "tag"},
            {"label": "#", "bind": "id"}
          ],
          "actions": [
            {"verb": "open", "screen": "process", "record": "=id"},
            {"verb": "stop", "command": "deck.process_stop", "params": {"process": "=id"}, "when": "(finished_at ?? '') == ''"}
          ]}
      ]}
    ]}
  ]
}
