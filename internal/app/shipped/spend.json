            {
              "type": "chart",
              "title": "Paid by day",
              "kind": "bar",
              "span": "full",
              "source": {
                "from": "deck.spend_daily",
                "input": {
                  "days": 30
                }
              },
              "x": "day",
              "format": "money",
              "currency": "USD",
              "series": [
                {
                  "label": "Paid",
                  "y": "cost_usd"
                }
              ]
            },
            {
              "type": "table",
              "title": "By day",
              "span": "full",
              "source": {
                "from": "deck.spend_daily",
                "input": {
                  "days": 30
                },
                "sort": "-day"
              },
              "columns": [
                {
                  "label": "Day",
                  "bind": "day",
                  "format": "date"
                },
                {
                  "label": "Calls",
                  "bind": "calls"
                },
                {
                  "label": "Tokens",
