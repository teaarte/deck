{
  "version": 9,
  "icon": "sparkles",
  "commands": [
    {
      "name": "reply",
      "title": "Reply",
      "description": "Answers the owner's messages in a chat topic.",
      "class": "internal",
      "callers": [
        "trigger"
      ],
      "requires": [
        "tools"
      ],
      "provider": "claude-code",
      "input": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "integer",
            "description": "The chat topic"
          }
        },
        "required": [
          "topic"
        ]
      },
      "executor": {
        "type": "agent",
        "prompt_file": "prompts/reply.md",
        "skills": [
          "dispatch",
          "topic-summary",
          "memory",
          "module-builder",
          "code-project"
        ]
      }
    },
    {
      "name": "memory",
      "title": "Clean up memory",
      "description": "Merges, shortens and deletes facts of the memory of the owner and of each project by the memory skill.",
      "class": "internal",
      "callers": [
        "owner",
        "trigger"
      ],
      "requires": [
        "tools"
      ],
      "provider": "claude-code",
      "executor": {
        "type": "agent",
        "prompt_file": "prompts/memory.md",
        "skills": [
          "memory"
        ],
        "calls": [
          "deck.projects_list",
          "deck.documents_list",
          "deck.document_get",
          "deck.document_save",
          "deck.document_delete"
        ]
      }
    },
    {
      "name": "review",
      "title": "Daily review",
      "description": "Looks over the projects of deck and tells the owner in the feed what is worth doing.",
      "class": "internal",
      "callers": [
        "owner",
        "trigger"
      ],
      "requires": [
        "tools"
      ],
      "provider": "claude-code",
      "executor": {
        "type": "agent",
        "prompt_file": "prompts/review.md",
        "calls": [
          "deck.projects_list",
          "deck.processes_list",
          "deck.process_get",
          "deck.process_log",
          "deck.documents_list",
          "deck.document_get",
          "deck.manifest_get",
          "deck.asks_list",
          "deck.records_list",
          "deck.record_get",
          "deck.health_list",
          "deck.notify"
        ]
      }
    },
    {
      "name": "on_error",
      "title": "Look into an error",
      "description": "Finds out why a process or a block of a screen of a project failed and tells the owner the fix in the feed.",
      "class": "internal",
      "callers": [
        "owner",
        "trigger"
      ],
      "requires": [
        "tools"
      ],
      "provider": "claude-code",
      "input": {
        "type": "object",
        "properties": {
          "process": {
            "type": "integer",
            "format": "process",
            "description": "The process that failed"
          },
          "project": {
            "type": "string",
            "description": "The project with a screen that failed"
          },
          "screen": {
            "type": "string",
            "description": "The screen with a block that failed"
          },
          "error": {
            "type": "string",
            "description": "The block and its error"
          }
        }
      },
      "executor": {
        "type": "agent",
        "prompt_file": "prompts/on_error.md",
        "calls": [
          "deck.projects_list",
          "deck.processes_list",
          "deck.process_get",
          "deck.process_log",
          "deck.documents_list",
          "deck.document_get",
          "deck.manifest_get",
          "deck.models_list",
          "deck.model_set",
          "deck.asks_list",
          "deck.records_list",
          "deck.record_get",
          "deck.health_list",
          "deck.notify"
        ]
      }
    }
  ],
  "triggers": [
    {
      "command": "reply",
      "on": "message"
    },
    {
      "command": "on_error",
      "on": "failure"
    },
    {
      "command": "memory",
      "cron": "0 10 * * 1"
    },
    {
      "command": "review",
      "cron": "30 10 * * *"
    }
  ]
}
