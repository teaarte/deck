{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "dockerfile",
    "gomod",
    "github-actions",
    "custom.regex"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The version of Claude Code deck's image installs",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CLAUDE_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@anthropic-ai/claude-code"
    },
    {
      "customType": "regex",
      "description": "The version of Codex deck's image installs and tests/linux tests",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CODEX_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@openai/codex"
    },
    {
      "customType": "regex",
      "description": "The version of sqlc ci checks the generated code with",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "SQLC_VERSION: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sqlc-dev/sqlc",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
