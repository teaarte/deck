{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "catalogId": "https://deck2.local/catalog/v1",
  "description": "Blocks of deck screens as A2UI components. A block's data is at the path of its data property: {state, error?, filters?, rows | items | value | lines}. block is the form a manifest stores the block in; its refs are the $defs of the manifest schema.",
  "components": {
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "title": {"type": "string"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "columns": {
      "description": "Blocks side by side.",
      "block": {"required": ["blocks"], "properties": {"blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "title": {"type": "string"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "tabs": {
      "description": "Blocks in tabs.",
      "block": {"required": ["tabs"], "properties": {"tabs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "blocks"], "properties": {"title": {"type": "string", "minLength": 1}, "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}}}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["titles", "children"],
      "properties": {
        "title": {"type": "string"},
        "titles": {"type": "array", "items": {"type": "string"}},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "table": {
      "description": "Rows of a source.",
      "block": {"required": ["source", "columns"], "properties": {"source": {"$ref": "#/$defs/source"}, "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bind"}}, "filter": {"$ref": "#/$defs/filter"}, "actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "data"],
      "properties": {
        "title": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "rows: [{id, cells, actions}]"}
      }
    },
    "list": {
      "description": "Lines of a source.",
      "block": {"required": ["source", "item"], "properties": {"source": {"$ref": "#/$defs/source"}, "item": {"type": "object", "additionalProperties": false, "required": ["title"], "description": "Expressions of each line.", "properties": {"title": {"type": "string"}, "text": {"type": "string"}, "meta": {"type": "string"}}}, "filter": {"$ref": "#/$defs/filter"}, "actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "items: [{id, title, text, meta, details, questions, actions}]"}
      }
    },
    "card": {
      "description": "Fields of the record of a record page.",
      "block": {"properties": {"fields": {"type": "array", "items": {"$ref": "#/$defs/bind"}}, "actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {fields: [{label, value}], actions}"}
      }
    },
    "stat": {
      "description": "One value over the items of a source.",
      "block": {"required": ["source"], "properties": {"source": {"$ref": "#/$defs/source"}, "value": {"type": "string", "description": "Expression over rows, the items of the source, such as len(rows) or sum(rows, .amount); len(rows) by default."}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: a number or a text"}
      }
    },
    "actions": {
      "description": "A group of buttons without a source.",
      "block": {"required": ["actions"], "properties": {"actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "title": {"type": "string"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "log": {
      "description": "The log of the process of a record page.",
      "block": {"required": ["source"], "properties": {"source": {"$ref": "#/$defs/source"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "lines: [{at, kind, id, title, status, text}]"}
      }
    },
    "board": {
      "description": "The board of the project.",
      "block": {"properties": {}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {project, lanes: [{name, title, role, cards: [{id, title, text, waits, record}]}], deleted: [{id, title}]}"}
      }
    },
    "form": {
      "description": "Asks for the input of a command and shows its result: one command, or a pick from the commands source.",
      "block": {"oneOf": [{"required": ["command"]}, {"required": ["source"]}], "properties": {"command": {"type": "string", "description": "deck.record_update on a record page edits the record."}, "source": {"allOf": [{"$ref": "#/$defs/source"}, {"required": ["from"], "properties": {"from": {"const": "commands"}}}]}, "save": {"type": "string", "description": "Collection the owner can keep the result in."}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {commands: [{name, title, project, input, result}], values, readonly, record, save}"}
      }
    },
    "custom": {
      "description": "An MCP App: HTML of a custom/ document, fed by its source, pressing only its buttons.",
      "block": {"required": ["document"], "properties": {"document": {"type": "string", "pattern": "^custom/"}, "source": {"$ref": "#/$defs/source"}, "actions": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/action"}, {"required": ["command"], "not": {"required": ["screen"]}}]}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {html, items, record, actions}"}
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "description": "A button: a command call or a move to a screen. verb names a built-in label the client translates.",
      "properties": {
        "label": {"type": "string"},
        "verb": {"type": "string"},
        "primary": {"type": "boolean"},
        "command": {"type": "string"},
        "params": {"type": "object"},
        "input": {"type": "string", "description": "Param the owner types before the call."},
        "until": {"type": "string", "description": "Time after which the button is hidden."},
        "project": {"type": "string"},
        "screen": {"type": "string"},
        "record": {"type": "integer"}
      }
    },
    "data": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["ready", "empty", "error"]},
        "error": {"type": "string"},
        "filters": {"type": "array", "description": "Choices the owner narrows the block by; the client sends the picked ones back to deck.screen.", "items": {
          "type": "object", "required": ["field", "options"], "additionalProperties": false,
          "properties": {"field": {"type": "string"}, "value": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}}
        }},
        "rows": {"type": "array", "items": {
          "type": "object", "required": ["id", "cells"], "additionalProperties": false,
          "properties": {"id": {}, "cells": {"type": "array"}, "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}
        }},
        "items": {"type": "array", "items": {
          "type": "object", "required": ["id", "title"], "additionalProperties": false,
          "properties": {
            "id": {}, "title": {"type": "string"}, "text": {"type": "string"}, "meta": {"type": "string"},
            "details": {"type": "string"},
            "questions": {"type": "array", "items": {
              "type": "object", "required": ["question"],
              "properties": {"question": {"type": "string"}, "multiSelect": {"type": "boolean"},
                "options": {"type": "array", "items": {"type": "object", "properties": {"label": {"type": "string"}, "description": {"type": "string"}}}}}
            }},
            "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
          }
        }},
        "value": {},
        "lines": {"type": "array", "items": {
          "type": "object", "required": ["at", "kind"],
          "properties": {"at": {"type": "string"}, "kind": {"type": "string"}, "id": {"type": "string"}, "title": {"type": "string"},
            "status": {"type": "string"}, "text": {"type": "string"}}
        }}
      }
    }
  }
}
