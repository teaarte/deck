{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "catalogId": "https://deck2.local/catalog/v1",
  "final_states": ["done", "error", "interrupted", "stopped"],
  "topics": ["collection", "asks", "processes", "feed", "health", "log", "board", "triggers", "secrets", "tokens", "settings", "documents", "files", "snapshots", "chat", "calls", "usage", "projects"],
  "description": "Blocks of deck screens as A2UI components. A block's data is at the path of its data property: {state, error?, filters?, rows | items | value | lines}. block is the form a manifest stores the block in; its refs are the $defs of the manifest schema.",
  "components": {
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"},
        "dialogs": {"$ref": "common_types.json#/$defs/ChildList", "description": "The dialogs of the screen, their buttons beside its title."}
      }
    },
    "columns": {
      "description": "Blocks side by side.",
      "block": {"description": "Holds at least one block in blocks, side by side; nothing else.", "required": ["blocks"], "properties": {"blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "dialog": {
      "description": "A button that opens its blocks in a window over the screen; ?dialog=<name> in the address of the screen opens it too, and a form in it closes it once its call went through.",
      "block": {"description": "Needs title (the label of its button), name and at least one block in blocks; primary paints its button in the accent.", "required": ["title", "name", "blocks"], "properties": {"name": {"$ref": "#/$defs/name"}, "primary": {"type": "boolean"}, "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["children", "name"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "name": {"type": "string"},
        "primary": {"type": "boolean"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "tabs": {
      "description": "Blocks in tabs.",
      "block": {"description": "Holds its tabs in tabs, each with a title and at least one block; nothing else.", "required": ["tabs"], "properties": {"tabs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "blocks"], "properties": {"title": {"type": "string", "minLength": 1}, "icon": {"$ref": "#/$defs/icon"}, "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}}}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["titles", "children"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "titles": {"type": "array", "items": {"type": "string"}},
        "keys": {"type": "array", "items": {"type": "string"}, "description": "The title of each tab as written, its name in the address in every language."},
        "icons": {"type": "array", "items": {"type": "string"}, "description": "The icon of each tab, empty for none."},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "table": {
      "description": "Rows of a source.",
      "block": {"description": "Needs source and columns (each a label and bind, an expression over the row); filter and actions are optional.", "required": ["source", "columns"], "properties": {"source": {"$ref": "#/$defs/source"}, "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bind"}}, "filter": {"$ref": "#/$defs/filter"}, "actions": {"$ref": "#/$defs/actions"}, "actions_from": {"$ref": "#/$defs/actions_from"}, "empty": {"$ref": "#/$defs/empty"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string"}, "format": {"type": "string"}, "currency": {"type": "string"}}}},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "rows: [{id, cells, actions}]"}
      }
    },
    "list": {
      "description": "Lines of a source.",
      "block": {"description": "Needs source and item, whose title, text and meta are expressions over each item; filter and actions are optional.", "required": ["source", "item"], "properties": {"source": {"$ref": "#/$defs/source"}, "item": {"type": "object", "additionalProperties": false, "required": ["title"], "description": "Expressions of each line; details is text shown in full on demand, questions what the owner answers in a picker; markdown says the text is markdown.", "properties": {"title": {"type": "string"}, "text": {"type": "string"}, "meta": {"type": "string"}, "icon": {"type": "string", "description": "Expression giving the name of a Tabler icon of the line."}, "details": {"type": "string"}, "questions": {"type": "string"}, "markdown": {"type": "boolean"}, "tone": {"$ref": "#/$defs/tone"}}}, "filter": {"$ref": "#/$defs/filter"}, "actions": {"$ref": "#/$defs/actions"}, "actions_from": {"$ref": "#/$defs/actions_from"}, "empty": {"$ref": "#/$defs/empty"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "items: [{id, title, text, meta, details, questions, actions}]"}
      }
    },
    "card": {
      "description": "Fields of the record of a record page.",
      "block": {"description": "Shows the record of a record page; takes no source, only fields and actions; a field with no value (null or empty text) is not shown; a field with markdown shows its value as markdown.", "properties": {"fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "bind"], "properties": {"label": {"type": "string"}, "bind": {"type": "string", "description": "Expression over the fields of the record."}, "markdown": {"type": "boolean"}, "format": {"$ref": "#/$defs/format"}, "currency": {"$ref": "#/$defs/currency"}, "tone": {"$ref": "#/$defs/tone"}}}}, "actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {fields: [{label, value}], actions}"}
      }
    },
    "stat": {
      "description": "One value over the items of a source.",
      "block": {"description": "Needs source; value is an expression over rows, len(rows) by default. With empty, a source without items shows that text instead of the value, so value can be rows[0].price with no len(rows) > 0 ? ... : '—'; a value that is null is empty too.", "required": ["source"], "properties": {"source": {"$ref": "#/$defs/source"}, "value": {"type": "string", "description": "Expression over rows, the items of the source, such as len(rows) or sum(rows, .amount); len(rows) by default."}, "format": {"$ref": "#/$defs/format"}, "currency": {"$ref": "#/$defs/currency"}, "tone": {"type": "string", "description": "Expression over rows that gives ok, warn, error or muted; any other value is no tone."}, "empty": {"$ref": "#/$defs/empty"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "format": {"type": "string"},
        "currency": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: a number or a text"}
      }
    },
    "chart": {
      "description": "A line, bar or area chart of the items of a source: one point per item, in the order of the sort of the source.",
      "block": {"description": "Needs source, x and series; x and each y are expressions over an item, a null y is a gap in the line. At most the last 500 points by the sort of the source are drawn; limit keeps the first items of the sort, so a long history is cut by the chart, not by limit. format and currency show the y values; an x that is an ISO 8601 time makes a time axis.", "required": ["source", "x", "series"], "properties": {
        "source": {"$ref": "#/$defs/source"},
        "kind": {"enum": ["line", "bar", "area"], "description": "line by default"},
        "x": {"type": "string", "description": "Expression over an item: the value on the x axis, such as at."},
        "series": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["label", "y"], "properties": {"label": {"type": "string", "minLength": 1}, "y": {"type": "string", "description": "Expression over an item: the value of the series, such as price."}}}},
        "format": {"$ref": "#/$defs/format"}, "currency": {"$ref": "#/$defs/currency"}, "empty": {"$ref": "#/$defs/empty"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "kind": {"type": "string"},
        "format": {"type": "string"},
        "currency": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {x: [...], series: [{label, values: [...]}]}"}
      }
    },
    "media": {
      "description": "Files of the items of a source: a picture as a thumbnail that opens in full, a PDF in place, any other file by name and size with a download.",
      "block": {"description": "Needs source and item.file, an expression over an item: the id of a stored file of the project (a result of its process, an attachment of its record) or a path in the data folder of the project; item.title is the caption. A file of another project or a path that is no file of the data folder is an error of its line, not of the block.", "required": ["source", "item"], "properties": {
        "source": {"$ref": "#/$defs/source"},
        "item": {"type": "object", "additionalProperties": false, "required": ["file"], "properties": {"file": {"type": "string"}, "title": {"type": "string"}}},
        "empty": {"$ref": "#/$defs/empty"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "files: [{id, title, name, type, size, url} or {id, title, error}]"}
      }
    },
    "actions": {
      "description": "A group of buttons without a source.",
      "block": {"description": "Needs actions; takes no source. The buttons past a few wait in its own menu.", "required": ["actions"], "properties": {"actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: the buttons, with the record of the page in their params"}
      }
    },
    "log": {
      "description": "The log of the process of a record page.",
      "block": {"description": "Needs source, deck.process_log of the process; takes nothing else.", "required": ["source"], "properties": {"source": {"$ref": "#/$defs/source"}, "empty": {"$ref": "#/$defs/empty"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "lines: [{at, kind, id, title, status, text}]"}
      }
    },
    "board": {
      "description": "The board of the project.",
      "block": {"description": "Reads the board of its own project; takes no source and no other field.", "properties": {}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {project, lanes: [{name, title, role, cards: [{id, title, text, waits, record}]}], deleted: [{id, title}]}"}
      }
    },
    "form": {
      "description": "Asks for the input of a command and shows its result: one command, or a pick from deck.commands_list.",
      "block": {"description": "Has either command or source from deck.commands_list to pick one, never both; it is its own button and takes no actions; save names a collection for the result.", "oneOf": [{"required": ["command"]}, {"required": ["source"]}], "properties": {"command": {"type": "string", "description": "deck.record_update on a record page edits the record."}, "source": {"allOf": [{"$ref": "#/$defs/source"}, {"required": ["from"], "properties": {"from": {"const": "deck.commands_list"}}}]}, "save": {"type": "string", "description": "Collection the owner can keep the result in."}, "keep_open": {"type": "boolean", "description": "In a dialog the form stays open after its call to show the result, such as a token shown once; otherwise the dialog closes."}, "values": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Fields filled before the owner types, by field: fixed text, $param.<name> from the address of the screen, or $record.<field>."}, "choices": {"type": "object", "description": "Values offered for fields of the input, by field: a source and expressions over its items for the value and its label.", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["source", "value"], "properties": {"source": {"$ref": "#/$defs/source"}, "value": {"type": "string"}, "label": {"type": "string"}}}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {commands: [{name, title, project, input, result}], values, readonly, record, save}"}
      }
    },
    "appearance": {
      "description": "How deck looks on the device: theme, color scheme, accent, surfaces, density, font size, corners; with part pushes, the pushes of the device.",
      "block": {"description": "Only on deck's own screens; takes no source; part picks the look (by default) or the pushes of the device.", "properties": {"part": {"enum": ["look", "pushes"]}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "part": {"enum": ["look", "pushes"]},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "the client keeps the look; the data is only its state"}
      }
    },
    "document": {
      "description": "A document of the project: its text, markdown drawn, edited as text when it is md, its revisions and going back to one.",
      "block": {"description": "Names the document in document; on a record page it is a document of the record, else of the project. A document page shows its own document and takes no field.", "properties": {"document": {"type": "string", "minLength": 1}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {id, project, name, kind, text, revision, editable, record, card, revisions}"}
      }
    },
    "custom": {
      "description": "An MCP App: HTML of a custom/ document, fed by its source, pressing only its buttons.",
      "block": {"description": "Needs document, a custom/ document with its HTML; its buttons call commands and never move to a screen.", "required": ["document"], "properties": {"document": {"type": "string", "pattern": "^custom/"}, "source": {"$ref": "#/$defs/source"}, "actions": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/action"}, {"required": ["command"], "not": {"required": ["screen"]}}]}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {html, items, record, actions}"}
      }
    },
    "chat": {
      "description": "The chat with the master: the topics, the messages of one, the master's questions in it and the turn going on, with send, stop, archive and delete.",
      "block": {"description": "Needs source deck.chat and no other field; the client picks the topic as the filter topic of the block: a topic id, new for a new one, empty for the newest.", "required": ["source"], "properties": {"source": {"$ref": "#/$defs/source"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "icon": {"type": "string"},
        "span": {"enum": [1, 2, "full"]},
        "description": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: chat"}
      }
    }
  },
  "$defs": {
    "tone": {"enum": ["ok", "warn", "error", "muted"], "description": "How a value stands: ok, warn, error or muted."},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "description": "A button: a command call or a move to a screen. verb names a built-in label the client translates.",
      "properties": {
        "label": {"type": "string"},
        "verb": {"type": "string"},
        "icon": {"type": "string", "description": "Name of a Tabler icon on the button."},
        "primary": {"type": "boolean"},
        "command": {"type": "string"},
        "params": {"type": "object"},
        "input": {"type": "string", "description": "Param the owner types before the call."},
        "until": {"type": "string", "description": "Time after which the button is hidden."},
        "project": {"type": "string"},
        "screen": {"type": "string"},
        "record": {"type": "integer"},
        "class": {"type": "string", "description": "Class of the command of a custom block's button; the host asks the owner before one that is not internal."},
        "confirm": {"type": "boolean", "description": "The client asks the owner before the call: a button of deck that deletes or revokes."},
        "options": {"type": "array", "items": {"type": "string"}, "description": "Values the owner picks the input from."},
        "chat": {"type": "boolean", "description": "The result names a chat topic, which the client opens."},
        "file": {"type": "integer", "description": "Stored file the button downloads instead of a call."},
        "undo": {"$ref": "#/$defs/action", "description": "The call that takes this one back; the client offers it for a moment after the call went through."}
      }
    },
    "values": {
      "description": "The value of the data of each block that has one, by component.",
      "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
      "card": {"type": "object", "additionalProperties": false, "required": ["fields", "actions"], "properties": {
        "fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string"}, "value": {}, "markdown": {"type": "boolean"}, "format": {"type": "string"}, "currency": {"type": "string"}, "tone": {"$ref": "#/$defs/tone"}}}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}},
      "stat": {"type": ["number", "string", "boolean", "null"]},
      "chart": {"type": "object", "additionalProperties": false, "required": ["x", "series"], "properties": {
        "x": {"type": "array"},
        "series": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "values"], "properties": {
          "label": {"type": "string"}, "values": {"type": "array", "items": {"type": ["number", "null"]}}}}}}},
      "board": {"type": "object", "additionalProperties": false, "required": ["project", "lanes", "deleted"], "properties": {
        "project": {"type": "string"},
        "lanes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "title", "cards"], "properties": {
          "name": {"type": "string"}, "title": {"type": "string"}, "role": {"type": "string"},
          "cards": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {
            "id": {"type": "integer"}, "title": {"type": "string"}, "text": {"type": "string"}, "waits": {"type": "array", "items": {"type": "integer"}}, "record": {"type": "integer"}, "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}}}}}},
        "deleted": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {"id": {"type": "integer"}, "title": {"type": "string"}}}}}},
      "form": {"type": "object", "additionalProperties": false, "required": ["project", "commands"], "properties": {
        "project": {"type": "string"},
        "commands": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "title", "input", "order"], "properties": {
          "name": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "project": {"type": "string"},
          "input": {"type": "object"}, "order": {"type": ["array", "null"], "items": {"type": "string"}}, "result": {}}}},
        "values": {"type": "object"}, "readonly": {"type": "array", "items": {"type": "string"}}, "record": {"type": "integer"}, "save": {"type": "string"}, "keep_open": {"type": "boolean"},
        "choices": {"type": "object", "description": "Values offered by field", "additionalProperties": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["value", "label"], "properties": {"value": {}, "label": {"type": "string"}}}}}}},
      "document": {"type": "object", "additionalProperties": false, "required": ["id", "project", "name", "kind", "text", "revision", "editable", "revisions"], "properties": {
        "id": {"type": "integer", "description": "0 while the document is not written yet"}, "project": {"type": "string"}, "name": {"type": "string"}, "kind": {"type": "string"},
        "text": {"type": "string"}, "revision": {"type": "integer"}, "editable": {"type": "boolean"}, "record": {"type": "integer"}, "card": {"type": "integer"},
        "revisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["revision", "author", "created_at"], "properties": {
          "revision": {"type": "integer"}, "author": {"type": "string"}, "reason": {"type": "string"}, "created_at": {"type": "string"}}}}}},
      "custom": {"type": "object", "additionalProperties": false, "required": ["html", "actions"], "properties": {
        "html": {"type": "string"}, "items": {"type": "array", "items": {"type": "object"}}, "record": {"type": "object"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}},
      "chat": {"type": "object", "additionalProperties": false, "required": ["topics", "archived", "messages", "questions", "send"], "properties": {
        "topic": {"$ref": "#/$defs/topic"}, "topics": {"type": "array", "items": {"$ref": "#/$defs/topic"}},
        "archived": {"type": "array", "items": {"$ref": "#/$defs/topic"}},
        "messages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "role", "text", "created_at"], "properties": {
          "id": {"type": "integer"}, "role": {"enum": ["owner", "master"]}, "text": {"type": "string"}, "process": {"type": "integer"},
          "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}}},
          "screen": {"type": "object", "description": "the screen the owner wrote it on: project, screen, record, card, process"},
          "reply": {"$ref": "#/$defs/reply"}, "created_at": {"type": "string"}}}},
        "questions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ask", "text", "questions", "answer"], "properties": {
          "ask": {"type": "integer"}, "text": {"type": "string"},
          "questions": {"type": "array", "items": {"type": "object", "required": ["question"], "properties": {"question": {"type": "string"}, "multiSelect": {"type": "boolean"},
            "options": {"type": "array", "items": {"type": "object", "properties": {"label": {"type": "string"}, "description": {"type": "string"}}}}}}},
          "answer": {"$ref": "#/$defs/action"}}}},
        "turn": {"type": "object", "additionalProperties": false, "required": ["process", "state", "lines"], "properties": {
          "process": {"type": "integer"}, "state": {"type": "string"}, "provider": {"type": "string"}, "waits": {"type": "string", "description": "what the reply waits for: the owner, a slot, a provider"},
          "lines": {"type": "array", "items": {"type": "object", "required": ["at", "kind"], "properties": {"at": {"type": "string"}, "kind": {"type": "string"},
            "id": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}, "text": {"type": "string"}}}},
          "stop": {"$ref": "#/$defs/action"}, "open": {"$ref": "#/$defs/action"}}},
        "send": {"$ref": "#/$defs/action"}, "archive": {"$ref": "#/$defs/action"}, "delete": {"$ref": "#/$defs/action"}}}
    },
    "topic": {"type": "object", "additionalProperties": false, "required": ["id", "title", "archived", "updated_at"], "properties": {
      "id": {"type": "integer"}, "title": {"type": "string"}, "card": {"type": "integer"}, "project": {"type": "string", "description": "the project of its card, else of the screen of its first message"}, "archived": {"type": "boolean"}, "updated_at": {"type": "string"},
      "last": {"type": "string", "description": "the last message, cut short"}, "reply": {"$ref": "#/$defs/reply"}}},
    "reply": {"type": "object", "additionalProperties": false, "required": ["process", "state"], "properties": {
      "process": {"type": "integer"}, "state": {"type": "string"}, "provider": {"type": "string"}, "error": {"type": "string"},
      "open": {"$ref": "#/$defs/action"}}},
    "data": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["ready", "empty", "error"]},
        "error": {"type": "string"},
        "empty": {"type": "string", "description": "the text of an empty block"},
        "tone": {"$ref": "#/$defs/tone"},
        "filters": {"type": "array", "description": "Choices the owner narrows the block by; the client sends the picked ones back to deck.screen.", "items": {
          "type": "object", "required": ["field", "options"], "additionalProperties": false,
          "properties": {"field": {"type": "string"}, "value": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}}
        }},
        "rows": {"type": "array", "items": {
          "type": "object", "required": ["id", "cells"], "additionalProperties": false,
          "properties": {"id": {}, "cells": {"type": "array"}, "tones": {"type": "array", "description": "the tone of each cell, null for none", "items": {"oneOf": [{"$ref": "#/$defs/tone"}, {"type": "null"}]}}, "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}
        }},
        "items": {"type": "array", "items": {
          "type": "object", "required": ["id", "title"], "additionalProperties": false,
          "properties": {
            "id": {}, "title": {"type": "string"}, "text": {"type": "string"}, "meta": {"type": "string"}, "icon": {"type": "string"},
            "details": {"type": "string"}, "markdown": {"type": "boolean", "description": "text is markdown"}, "tone": {"$ref": "#/$defs/tone"},
            "questions": {"type": "array", "items": {
              "type": "object", "required": ["question"],
              "properties": {"question": {"type": "string"}, "multiSelect": {"type": "boolean"},
                "options": {"type": "array", "items": {"type": "object", "properties": {"label": {"type": "string"}, "description": {"type": "string"}}}}}
            }},
            "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
          }
        }},
        "value": {},
        "files": {"type": "array", "items": {
          "type": "object", "required": ["id"], "additionalProperties": false,
          "properties": {"id": {}, "title": {"type": "string"}, "name": {"type": "string"}, "type": {"type": "string"}, "size": {"type": "integer"},
            "url": {"type": "string", "description": "where the client reads the file, with its token"}, "error": {"type": "string"}}
        }},
        "lines": {"type": "array", "items": {
          "type": "object", "required": ["at", "kind"],
          "properties": {"at": {"type": "string"}, "kind": {"type": "string"}, "id": {"type": "string"}, "title": {"type": "string"},
            "status": {"type": "string"}, "text": {"type": "string"}}
        }}
      }
    }
  }
}
