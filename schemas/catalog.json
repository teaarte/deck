{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "catalogId": "https://deck2.local/catalog/v1",
  "topics": ["collection", "asks", "processes", "unattended", "health", "log", "board", "triggers", "notifications", "secrets", "tokens"],
  "description": "Blocks of deck screens as A2UI components. A block's data is at the path of its data property: {state, error?, filters?, rows | items | value | lines}. block is the form a manifest stores the block in; its refs are the $defs of the manifest schema.",
  "components": {
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "title": {"type": "string"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "columns": {
      "description": "Blocks side by side.",
      "block": {"description": "Holds at least one block in blocks, side by side; nothing else.", "required": ["blocks"], "properties": {"blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["children"],
      "properties": {
        "title": {"type": "string"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "tabs": {
      "description": "Blocks in tabs.",
      "block": {"description": "Holds its tabs in tabs, each with a title and at least one block; nothing else.", "required": ["tabs"], "properties": {"tabs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "blocks"], "properties": {"title": {"type": "string", "minLength": 1}, "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}}}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["titles", "children"],
      "properties": {
        "title": {"type": "string"},
        "titles": {"type": "array", "items": {"type": "string"}},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      }
    },
    "table": {
      "description": "Rows of a source.",
      "block": {"description": "Needs source and columns (each a label and bind, an expression over the row); filter and actions are optional.", "required": ["source", "columns"], "properties": {"source": {"$ref": "#/$defs/source"}, "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bind"}}, "filter": {"$ref": "#/$defs/filter"}, "actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "data"],
      "properties": {
        "title": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "rows: [{id, cells, actions}]"}
      }
    },
    "list": {
      "description": "Lines of a source.",
      "block": {"description": "Needs source and item, whose title, text and meta are expressions over each item; filter and actions are optional.", "required": ["source", "item"], "properties": {"source": {"$ref": "#/$defs/source"}, "item": {"type": "object", "additionalProperties": false, "required": ["title"], "description": "Expressions of each line.", "properties": {"title": {"type": "string"}, "text": {"type": "string"}, "meta": {"type": "string"}}}, "filter": {"$ref": "#/$defs/filter"}, "actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "items: [{id, title, text, meta, details, questions, actions}]"}
      }
    },
    "card": {
      "description": "Fields of the record of a record page.",
      "block": {"description": "Shows the record of a record page; takes no source, only fields and actions.", "properties": {"fields": {"type": "array", "items": {"$ref": "#/$defs/bind"}}, "actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {fields: [{label, value}], actions}"}
      }
    },
    "stat": {
      "description": "One value over the items of a source.",
      "block": {"description": "Needs source; value is an expression over rows, len(rows) by default.", "required": ["source"], "properties": {"source": {"$ref": "#/$defs/source"}, "value": {"type": "string", "description": "Expression over rows, the items of the source, such as len(rows) or sum(rows, .amount); len(rows) by default."}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: a number or a text"}
      }
    },
    "actions": {
      "description": "A group of buttons without a source.",
      "block": {"description": "Needs actions; takes no source.", "required": ["actions"], "properties": {"actions": {"$ref": "#/$defs/actions"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: the buttons, with the record of the page in their params"}
      }
    },
    "log": {
      "description": "The log of the process of a record page.",
      "block": {"description": "Needs source; takes nothing else.", "required": ["source"], "properties": {"source": {"$ref": "#/$defs/source"}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "lines: [{at, kind, id, title, status, text}]"}
      }
    },
    "board": {
      "description": "The board of the project.",
      "block": {"description": "Reads the board of its own project; takes no source and no other field.", "properties": {}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {project, lanes: [{name, title, role, cards: [{id, title, text, waits, record}]}], deleted: [{id, title}]}"}
      }
    },
    "form": {
      "description": "Asks for the input of a command and shows its result: one command, or a pick from the commands source.",
      "block": {"description": "Has either command or source from commands to pick one, never both; it is its own button and takes no actions; save names a collection for the result.", "oneOf": [{"required": ["command"]}, {"required": ["source"]}], "properties": {"command": {"type": "string", "description": "deck.record_update on a record page edits the record."}, "source": {"allOf": [{"$ref": "#/$defs/source"}, {"required": ["from"], "properties": {"from": {"const": "commands"}}}]}, "save": {"type": "string", "description": "Collection the owner can keep the result in."}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {commands: [{name, title, project, input, result}], values, readonly, record, save}"}
      }
    },
    "appearance": {
      "description": "How deck looks on the device: color scheme, accent, density, font size, corners.",
      "block": {"description": "Only on deck's own screens; takes no source and no other field.", "properties": {}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "the client keeps the look; the data is only its state"}
      }
    },
    "custom": {
      "description": "An MCP App: HTML of a custom/ document, fed by its source, pressing only its buttons.",
      "block": {"description": "Needs document, a custom/ document with its HTML; its buttons call commands and never move to a screen.", "required": ["document"], "properties": {"document": {"type": "string", "pattern": "^custom/"}, "source": {"$ref": "#/$defs/source"}, "actions": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/action"}, {"required": ["command"], "not": {"required": ["screen"]}}]}}}},
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "title": {"type": "string"},
        "data": {"$ref": "common_types.json#/$defs/DynamicValue", "description": "value: {html, items, record, actions}"}
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "description": "A button: a command call or a move to a screen. verb names a built-in label the client translates.",
      "properties": {
        "label": {"type": "string"},
        "verb": {"type": "string"},
        "primary": {"type": "boolean"},
        "command": {"type": "string"},
        "params": {"type": "object"},
        "input": {"type": "string", "description": "Param the owner types before the call."},
        "until": {"type": "string", "description": "Time after which the button is hidden."},
        "project": {"type": "string"},
        "screen": {"type": "string"},
        "record": {"type": "integer"},
        "class": {"type": "string", "description": "Class of the command of a custom block's button; the host asks the owner before one that is not internal."},
        "confirm": {"type": "boolean", "description": "The client asks the owner before the call: a button of deck that deletes or revokes."}
      }
    },
    "values": {
      "description": "The value of the data of each block that has one, by component.",
      "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
      "card": {"type": "object", "additionalProperties": false, "required": ["fields", "actions"], "properties": {
        "fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string"}, "value": {}}}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}},
      "stat": {"type": ["number", "string", "boolean", "null"]},
      "board": {"type": "object", "additionalProperties": false, "required": ["project", "lanes", "deleted"], "properties": {
        "project": {"type": "string"},
        "lanes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "title", "cards"], "properties": {
          "name": {"type": "string"}, "title": {"type": "string"}, "role": {"type": "string"},
          "cards": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {
            "id": {"type": "integer"}, "title": {"type": "string"}, "text": {"type": "string"}, "waits": {"type": "array", "items": {"type": "integer"}}, "record": {"type": "integer"}}}}}}},
        "deleted": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {"id": {"type": "integer"}, "title": {"type": "string"}}}}}},
      "form": {"type": "object", "additionalProperties": false, "required": ["project", "commands"], "properties": {
        "project": {"type": "string"},
        "commands": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "title", "input", "order"], "properties": {
          "name": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "project": {"type": "string"},
          "input": {"type": "object"}, "order": {"type": ["array", "null"], "items": {"type": "string"}}, "result": {}}}},
        "values": {"type": "object"}, "readonly": {"type": "array", "items": {"type": "string"}}, "record": {"type": "integer"}, "save": {"type": "string"}}},
      "custom": {"type": "object", "additionalProperties": false, "required": ["html", "actions"], "properties": {
        "html": {"type": "string"}, "items": {"type": "array", "items": {"type": "object"}}, "record": {"type": "object"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}}
    },
    "data": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["ready", "empty", "error"]},
        "error": {"type": "string"},
        "filters": {"type": "array", "description": "Choices the owner narrows the block by; the client sends the picked ones back to deck.screen.", "items": {
          "type": "object", "required": ["field", "options"], "additionalProperties": false,
          "properties": {"field": {"type": "string"}, "value": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}}
        }},
        "rows": {"type": "array", "items": {
          "type": "object", "required": ["id", "cells"], "additionalProperties": false,
          "properties": {"id": {}, "cells": {"type": "array"}, "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}}
        }},
        "items": {"type": "array", "items": {
          "type": "object", "required": ["id", "title"], "additionalProperties": false,
          "properties": {
            "id": {}, "title": {"type": "string"}, "text": {"type": "string"}, "meta": {"type": "string"},
            "details": {"type": "string"},
            "questions": {"type": "array", "items": {
              "type": "object", "required": ["question"],
              "properties": {"question": {"type": "string"}, "multiSelect": {"type": "boolean"},
                "options": {"type": "array", "items": {"type": "object", "properties": {"label": {"type": "string"}, "description": {"type": "string"}}}}}
            }},
            "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
          }
        }},
        "value": {},
        "lines": {"type": "array", "items": {
          "type": "object", "required": ["at", "kind"],
          "properties": {"at": {"type": "string"}, "kind": {"type": "string"}, "id": {"type": "string"}, "title": {"type": "string"},
            "status": {"type": "string"}, "text": {"type": "string"}}
        }}
      }
    }
  }
}
