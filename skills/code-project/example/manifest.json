{
  "version": 13,
  "collections": [
    {
      "name": "tasks",
      "description": "A task of the repo: what the owner, the master or a routine asks, with the report of the run that did it.",
      "key": "title",
      "display": "title",
      "schema": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "A short imperative"
          },
          "text": {
            "type": "string",
            "description": "What to do, markdown; a run adds its report after a line ---"
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "ready",
              "running",
              "review",
              "done"
            ],
            "description": "backlog: later; ready: the next run takes it; running; review: a run did it and waits for the owner; done: merged"
          },
          "run": {
            "type": "integer",
            "description": "The run that worked on it"
          }
        }
      }
    }
  ],
  "commands": [
    {
      "name": "run",
      "title": "Run",
      "description": "Works on the ready tasks in the repo folder, or merges, reverts, pushes or shows a run.",
      "class": "internal",
      "callers": [
        "owner",
        "master"
      ],
      "provider": "claude-code",
      "timeout_minutes": 240,
      "input": {
        "type": "object",
        "properties": {
          "do": {
            "type": "string",
            "enum": [
              "run",
              "merge",
              "revert",
              "push",
              "diff"
            ],
            "description": "run by default"
          },
          "run": {
            "type": "integer",
            "format": "process",
            "description": "The run to merge, revert or show; the latest one when omitted"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "summary"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "description": "What was done, in plain words"
          },
          "branch": {
            "type": "string"
          }
        }
      },
      "executor": {
        "type": "agent",
        "folder": true,
        "prompt_file": "prompts/run.md"
      }
    }
  ],
  "screens": [
    {
      "name": "tasks",
      "title": "Tasks",
      "blocks": [
        {
          "type": "actions",
          "title": "Runs",
          "actions": [
            {
              "label": "Run",
              "command": "run",
              "params": {
                "do": "run"
              }
            },
            {
              "label": "Show the diff",
              "command": "run",
              "params": {
                "do": "diff"
              }
            },
            {
              "label": "Merge",
              "command": "run",
              "params": {
                "do": "merge"
              }
            },
            {
              "label": "Revert the merge",
              "command": "run",
              "params": {
                "do": "revert"
              }
            },
            {
              "label": "Push",
              "command": "run",
              "params": {
                "do": "push"
              }
            }
          ]
        },
        {
          "type": "table",
          "title": "Tasks",
          "source": {
            "collection": "tasks"
          },
          "filter": [
            "status"
          ],
          "columns": [
            {
              "label": "Task",
              "bind": "title"
            },
            {
              "label": "Status",
              "bind": "status",
              "format": "tag"
            },
            {
              "label": "Run",
              "bind": "run"
            }
          ],
          "actions": [
            {
              "label": "Open",
              "primary": true,
              "screen": "task"
            }
          ]
        },
        {
          "type": "list",
          "title": "Runs",
          "source": {
            "from": "deck.processes_list",
            "where": "command == 'run'",
            "limit": 10
          },
          "item": {
            "title": "'#' + string(id) + ' · ' + state",
            "text": "error",
            "meta": "started_at"
          }
        }
      ]
    },
    {
      "name": "task",
      "title": "Task",
      "record": "tasks",
      "blocks": [
        {
          "type": "form",
          "title": "Task",
          "command": "deck.record_update"
        }
      ]
    }
  ],
  "menu": [
    "tasks"
  ]
}
